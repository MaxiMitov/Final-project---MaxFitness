@{
    ViewData["Title"] = "Start Workout";
}

<!-- ============================================================
     WORKOUT PAGE HEADER
     ============================================================ -->
<section class="workout-header">
    <div class="container">
        <div class="workout-header-content">
            <div>
                <h1 class="workout-title">START <span class="text-gradient">WORKOUT</span></h1>
                <p class="workout-subtitle">Click a muscle group to add exercises. Track every set and rep.</p>
            </div>
            <div class="workout-timer-area">
                <div class="workout-timer-display" id="workoutTimer">
                    <i class="fa-solid fa-stopwatch"></i>
                    <span id="timerValue">00:00</span>
                </div>
                <button class="btn-accent btn-sm" id="timerStartBtn" onclick="toggleTimer()">
                    <i class="fa-solid fa-play" id="timerIcon"></i> <span id="timerBtnText">Start Timer</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     MAIN WORKOUT AREA: BODY MAP + ACTIVE EXERCISES
     ============================================================ -->
<section class="workout-section">
    <div class="container">
        <div class="workout-layout">

            <!-- LEFT: Interactive Body Map -->
            <div class="workout-body-map-area">
                <h3 class="workout-section-title">SELECT <span class="text-gradient">MUSCLE GROUP</span></h3>
                <p class="workout-body-hint">Click a muscle to browse and add exercises</p>
                <div class="workout-body-container">
                    <div class="body-map-glow"></div>
                    <svg viewBox="0 0 300 520" class="workout-body-svg" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <filter id="wkGlow" x="-50%" y="-50%" width="200%" height="200%">
                                <feGaussianBlur stdDeviation="6" result="blur" />
                                <feMerge>
                                    <feMergeNode in="blur" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                        </defs>

                        <!-- Body silhouette -->
                        <g class="body-silhouette" opacity="0.06">
                            <ellipse cx="150" cy="42" rx="32" ry="36" fill="white" />
                            <rect x="135" y="72" width="30" height="24" rx="6" fill="white" />
                            <path d="M100,96 Q90,96 80,110 L70,140 L65,180 L68,230 L105,240 L130,235 L150,232 L170,235 L195,240 L232,230 L235,180 L230,140 L220,110 Q210,96 200,96 Z" fill="white" />
                            <path d="M80,110 Q60,115 55,140 L50,180 L48,220 L52,250 L60,258 L70,250 L75,220 L80,180 Z" fill="white" />
                            <path d="M220,110 Q240,115 245,140 L250,180 L252,220 L248,250 L240,258 L230,250 L225,220 L220,180 Z" fill="white" />
                            <path d="M108,235 L100,290 L95,345 L96,400 L100,440 L105,470 L112,480 L130,480 L135,470 L138,440 L140,400 L142,345 L145,290 L148,240 Z" fill="white" />
                            <path d="M192,235 L200,290 L205,345 L204,400 L200,440 L195,470 L188,480 L170,480 L165,470 L162,440 L160,400 L158,345 L155,290 L152,240 Z" fill="white" />
                        </g>

                        <!-- Clickable muscle groups -->
                        <ellipse class="wk-muscle" data-muscle="shoulders" cx="93" cy="105" rx="27" ry="18" />
                        <ellipse class="wk-muscle" data-muscle="shoulders" cx="207" cy="105" rx="27" ry="18" />

                        <path class="wk-muscle" data-muscle="chest" d="M108,112 Q105,98 150,96 L150,158 Q110,156 108,142 Z" />
                        <path class="wk-muscle" data-muscle="chest" d="M192,112 Q195,98 150,96 L150,158 Q190,156 192,142 Z" />

                        <ellipse class="wk-muscle" data-muscle="biceps" cx="76" cy="155" rx="14" ry="32" />
                        <ellipse class="wk-muscle" data-muscle="biceps" cx="224" cy="155" rx="14" ry="32" />

                        <ellipse class="wk-muscle" data-muscle="forearms" cx="70" cy="218" rx="12" ry="30" />
                        <ellipse class="wk-muscle" data-muscle="forearms" cx="230" cy="218" rx="12" ry="30" />

                        <rect class="wk-muscle" data-muscle="abs" x="131" y="162" width="38" height="64" rx="6" />

                        <ellipse class="wk-muscle" data-muscle="legs" cx="127" cy="295" rx="22" ry="52" />
                        <ellipse class="wk-muscle" data-muscle="legs" cx="173" cy="295" rx="22" ry="52" />

                        <ellipse class="wk-muscle" data-muscle="legs" cx="123" cy="405" rx="16" ry="44" />
                        <ellipse class="wk-muscle" data-muscle="legs" cx="177" cy="405" rx="16" ry="44" />

                        <rect class="wk-muscle" data-muscle="back" x="112" y="96" width="6" height="60" rx="3" opacity="0.5" />
                        <rect class="wk-muscle" data-muscle="back" x="182" y="96" width="6" height="60" rx="3" opacity="0.5" />

                        <rect class="wk-muscle" data-muscle="triceps" x="62" y="125" width="12" height="40" rx="5" />
                        <rect class="wk-muscle" data-muscle="triceps" x="226" y="125" width="12" height="40" rx="5" />
                    </svg>

                    <!-- Labels around the body -->
                    <div class="wk-label wk-label--left" style="top: 16%; left: 0;">
                        <span class="wk-label-text">Shoulders</span>
                    </div>
                    <div class="wk-label wk-label--left" style="top: 28%; left: 0;">
                        <span class="wk-label-text">Biceps</span>
                    </div>
                    <div class="wk-label wk-label--left" style="top: 40%; left: 0;">
                        <span class="wk-label-text">Forearms</span>
                    </div>
                    <div class="wk-label wk-label--right" style="top: 20%; right: 0;">
                        <span class="wk-label-text">Chest</span>
                    </div>
                    <div class="wk-label wk-label--right" style="top: 33%; right: 0;">
                        <span class="wk-label-text">Triceps</span>
                    </div>
                    <div class="wk-label wk-label--right" style="top: 54%; right: 0;">
                        <span class="wk-label-text">Legs</span>
                    </div>
                    <div class="wk-label wk-label--center" style="top: 35%;">
                        <span class="wk-label-text">Abs</span>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Active Exercises -->
            <div class="workout-exercises-area">
                <div class="exercise-header-row">
                    <h3 class="workout-section-title">YOUR <span class="text-gradient">EXERCISES</span></h3>
                    <button class="btn-accent btn-sm" onclick="openExercisePicker(null)">
                        <i class="fa-solid fa-plus"></i> Add Exercise
                    </button>
                </div>

                <!-- Empty state -->
                <div class="exercise-empty" id="exerciseEmpty">
                    <i class="fa-solid fa-dumbbell"></i>
                    <p>No exercises added yet</p>
                    <span>Click a muscle group on the body or press "Add Exercise"</span>
                </div>

                <!-- Active exercise list -->
                <div class="exercise-log" id="exerciseLog">
                    <!-- Filled by JS -->
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     WORKOUT SUMMARY
     ============================================================ -->
<section class="workout-section" id="summarySection" style="display: none;">
    <div class="container">
        <h3 class="workout-section-title">WORKOUT <span class="text-gradient">SUMMARY</span></h3>
        <div class="summary-grid">
            <div class="summary-card card-dark">
                <div class="summary-card-icon"><i class="fa-solid fa-clock"></i></div>
                <span class="summary-card-label">Duration</span>
                <span class="summary-card-value" id="summaryDuration">00:00</span>
            </div>
            <div class="summary-card card-dark">
                <div class="summary-card-icon"><i class="fa-solid fa-dumbbell"></i></div>
                <span class="summary-card-label">Total Sets</span>
                <span class="summary-card-value" id="summaryTotalSets">0</span>
            </div>
            <div class="summary-card card-dark">
                <div class="summary-card-icon"><i class="fa-solid fa-repeat"></i></div>
                <span class="summary-card-label">Total Reps</span>
                <span class="summary-card-value" id="summaryTotalReps">0</span>
            </div>
            <div class="summary-card card-dark">
                <div class="summary-card-icon"><i class="fa-solid fa-weight-hanging"></i></div>
                <span class="summary-card-label">Total Volume</span>
                <span class="summary-card-value" id="summaryVolume">0 <span class="summary-unit">kg</span></span>
            </div>
            <div class="summary-card card-dark summary-card--intensity">
                <div class="summary-card-icon"><i class="fa-solid fa-fire"></i></div>
                <span class="summary-card-label">Intensity</span>
                <span class="summary-card-value" id="summaryIntensity">--</span>
                <div class="intensity-bar-container">
                    <div class="intensity-bar-fill" id="intensityBar" style="width: 0%;"></div>
                </div>
                <span class="intensity-level" id="intensityLevel">--</span>
            </div>
        </div>
        <div class="finish-workout-area">
            <button class="btn-accent btn-xl" onclick="finishWorkout()">
                <i class="fa-solid fa-flag-checkered"></i> Finish Workout
            </button>
        </div>
    </div>
</section>


<!-- ============================================================
     EXERCISE PICKER MODAL
     ============================================================ -->
<div class="modal-overlay" id="exercisePickerModal">
    <div class="picker-box">
        <div class="picker-header">
            <h4 class="picker-title">ADD <span class="text-gradient">EXERCISES</span></h4>
            <button class="picker-close-btn" onclick="closePickerModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Muscle group tabs -->
        <div class="picker-tabs" id="pickerTabs">
            <button class="picker-tab active" data-filter="all" onclick="filterPickerTab(this)">All</button>
            <button class="picker-tab" data-filter="chest" onclick="filterPickerTab(this)">Chest</button>
            <button class="picker-tab" data-filter="back" onclick="filterPickerTab(this)">Back</button>
            <button class="picker-tab" data-filter="shoulders" onclick="filterPickerTab(this)">Shoulders</button>
            <button class="picker-tab" data-filter="biceps" onclick="filterPickerTab(this)">Biceps</button>
            <button class="picker-tab" data-filter="triceps" onclick="filterPickerTab(this)">Triceps</button>
            <button class="picker-tab" data-filter="legs" onclick="filterPickerTab(this)">Legs</button>
            <button class="picker-tab" data-filter="abs" onclick="filterPickerTab(this)">Abs</button>
            <button class="picker-tab" data-filter="forearms" onclick="filterPickerTab(this)">Forearms</button>
        </div>

        <!-- Search -->
        <div class="picker-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" class="picker-search-input" id="pickerSearch" placeholder="Search exercises..." oninput="filterPickerList()" />
        </div>

        <!-- Exercise list -->
        <div class="picker-list" id="pickerList">
            <!-- Filled by JS -->
        </div>

        <!-- Custom exercise -->
        <div class="picker-custom">
            <input type="text" class="picker-custom-input" id="customExerciseName" placeholder="Or type a custom exercise name..." />
            <button class="btn-ghost btn-sm" onclick="addCustomFromPicker()">
                <i class="fa-solid fa-plus"></i> Add Custom
            </button>
        </div>

        <!-- Footer -->
        <div class="picker-footer">
            <span class="picker-selected-count" id="pickerSelectedCount">0 selected</span>
            <button class="btn-accent btn-sm" onclick="confirmPickerSelection()">
                <i class="fa-solid fa-check"></i> Add Selected
            </button>
        </div>
    </div>
</div>


<!-- ============================================================
     FINISH WORKOUT OVERLAY
     ============================================================ -->
<div class="finish-overlay" id="finishOverlay">
    <div class="finish-bg-glow finish-bg-glow--1"></div>
    <div class="finish-bg-glow finish-bg-glow--2"></div>
    <div class="finish-content" id="finishContent">
        <!-- Filled by JS animation -->
    </div>
</div>


<!-- ============================================================
     STYLES
     ============================================================ -->
<style>
    .workout-header {
        padding: 6rem 0 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .workout-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .workout-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        margin-bottom: 0.3rem;
    }

    .workout-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .workout-timer-area {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .workout-timer-display {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        padding: 0.6rem 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1.5rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        color: var(--text-primary);
    }

    .workout-timer-display i { color: var(--accent); font-size: 1.1rem; }

    .workout-section {
        padding: 2.5rem 0;
    }

    .workout-section-title {
        font-size: 1.3rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 1.5rem;
    }

    /* ===== MAIN 2-COL LAYOUT ===== */
    .workout-layout {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 3rem;
        align-items: start;
    }

    /* ===== BODY MAP ===== */
    .workout-body-map-area {
        position: sticky;
        top: 80px;
    }

    .workout-body-hint {
        color: var(--text-secondary);
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        margin-top: -1rem;
    }

    .workout-body-container {
        position: relative;
        display: flex;
        justify-content: center;
        padding: 1rem 2rem;
    }

    .workout-body-svg {
        width: 100%;
        max-width: 260px;
        height: auto;
        position: relative;
        z-index: 1;
    }

    .wk-muscle {
        fill: rgba(255,255,255,0.04);
        stroke: rgba(255,255,255,0.12);
        stroke-width: 1;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .wk-muscle:hover {
        fill: rgba(230,57,70,0.25);
        stroke: rgba(230,57,70,0.6);
        stroke-width: 1.5;
        filter: url(#wkGlow);
    }

    /* Active (has exercises) state */
    .wk-muscle.wk-active {
        fill: rgba(34,197,94,0.2);
        stroke: rgba(34,197,94,0.5);
        stroke-width: 1.5;
    }

    .wk-muscle.wk-active:hover {
        fill: rgba(34,197,94,0.35);
        stroke: rgba(34,197,94,0.8);
        filter: url(#wkGlow);
    }

    /* Labels */
    .wk-label {
        position: absolute;
        pointer-events: none;
        z-index: 2;
    }

    .wk-label-text {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .wk-label--left { text-align: right; }
    .wk-label--right { text-align: left; }
    .wk-label--center { left: 50%; transform: translateX(-50%); }

    /* ===== EXERCISE AREA ===== */
    .exercise-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .exercise-header-row .workout-section-title { margin-bottom: 0; }

    .exercise-empty {
        background: var(--bg-card);
        border: 1px dashed rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 3rem 2rem;
        text-align: center;
        color: var(--text-secondary);
    }

    .exercise-empty i {
        font-size: 2.5rem;
        opacity: 0.2;
        margin-bottom: 0.75rem;
        display: block;
    }

    .exercise-empty p {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.3rem;
        color: var(--text-primary);
    }

    .exercise-empty span { font-size: 0.85rem; }

    /* Exercise items */
    .exercise-log {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .exercise-item {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .exercise-item:hover { border-color: rgba(230,57,70,0.15); }

    .exercise-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .exercise-item-name {
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .exercise-item-name i { color: var(--accent); font-size: 0.85rem; }

    .exercise-muscle-tag {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
        background: rgba(34,197,94,0.1);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.2);
    }

    .exercise-item-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        background: rgba(230,57,70,0.1);
        color: var(--accent);
        border: 1px solid rgba(230,57,70,0.2);
    }

    .exercise-item-actions { display: flex; align-items: center; gap: 0.5rem; }

    .exercise-remove-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        padding: 0.3rem;
        border-radius: 4px;
        transition: all 0.2s;
        font-size: 0.85rem;
    }

    .exercise-remove-btn:hover {
        color: var(--accent);
        background: rgba(230,57,70,0.1);
    }

    /* Sets Table */
    .sets-table { width: 100%; padding: 0.75rem 1.25rem 1rem; }

    .sets-table-header {
        display: grid;
        grid-template-columns: 50px 1fr 1fr 50px;
        gap: 0.75rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        margin-bottom: 0.5rem;
    }

    .sets-table-header span {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
    }

    .set-row {
        display: grid;
        grid-template-columns: 50px 1fr 1fr 50px;
        gap: 0.75rem;
        align-items: center;
        padding: 0.4rem 0;
    }

    .set-number { font-size: 0.85rem; font-weight: 800; color: var(--accent); text-align: center; }

    .set-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 6px;
        padding: 0.5rem 0.6rem;
        color: var(--text-primary);
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
        width: 100%;
        transition: all 0.2s;
        font-variant-numeric: tabular-nums;
    }

    .set-input:focus {
        outline: none;
        border-color: rgba(230,57,70,0.4);
        background: rgba(230,57,70,0.06);
    }

    .set-input::placeholder { color: var(--text-dim, #4a4a5e); font-weight: 400; }

    .set-remove-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: 0.8rem;
        padding: 0.3rem;
        border-radius: 4px;
        transition: all 0.2s;
        text-align: center;
    }

    .set-remove-btn:hover { color: var(--accent); background: rgba(230,57,70,0.1); }

    .add-set-btn {
        background: rgba(255,255,255,0.03);
        border: 1px dashed rgba(255,255,255,0.1);
        border-radius: 6px;
        color: var(--text-secondary);
        padding: 0.5rem;
        width: 100%;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
        margin-top: 0.5rem;
    }

    .add-set-btn:hover { border-color: rgba(230,57,70,0.3); color: var(--accent); background: rgba(230,57,70,0.05); }

    /* ===== SUMMARY ===== */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
    }

    .summary-card {
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
    }

    .summary-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(230,57,70,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        color: var(--accent);
        margin-bottom: 0.3rem;
    }

    .summary-card-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
    }

    .summary-card-value { font-size: 1.6rem; font-weight: 800; color: var(--text-primary); }
    .summary-unit { font-size: 0.8rem; font-weight: 500; color: var(--text-secondary); }
    .summary-card--intensity { border-color: rgba(230,57,70,0.2); }

    .intensity-bar-container { width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 6px; overflow: hidden; margin-top: 0.3rem; }
    .intensity-bar-fill { height: 100%; border-radius: 6px; transition: width 0.5s ease, background 0.5s ease; }
    .intensity-level { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.15rem 0.5rem; border-radius: 20px; margin-top: 0.2rem; }
    .intensity-low { color: #22c55e; }
    .intensity-bar-fill.intensity-low { background: #22c55e; }
    .intensity-moderate { color: #ffd166; }
    .intensity-bar-fill.intensity-moderate { background: #ffd166; }
    .intensity-high { color: #ff6b35; }
    .intensity-bar-fill.intensity-high { background: linear-gradient(90deg, #ff6b35, #e63946); }
    .intensity-extreme { color: #e63946; }
    .intensity-bar-fill.intensity-extreme { background: linear-gradient(90deg, #e63946, #ff2040); }

    .finish-workout-area { text-align: center; padding: 2.5rem 0 1rem; }

    /* ===== PICKER MODAL ===== */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(6px);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .modal-overlay.active { opacity: 1; pointer-events: all; }

    .picker-box {
        background: var(--bg-secondary, #111118);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        width: 90%;
        max-width: 560px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        transform: translateY(20px) scale(0.97);
        transition: transform 0.3s ease;
        overflow: hidden;
    }

    .modal-overlay.active .picker-box { transform: translateY(0) scale(1); }

    .picker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .picker-title { font-size: 1.1rem; font-weight: 800; text-transform: uppercase; margin: 0; }

    .picker-close-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0.3rem;
        border-radius: 6px;
        transition: all 0.2s;
    }

    .picker-close-btn:hover { color: var(--accent); background: rgba(230,57,70,0.1); }

    /* Tabs */
    .picker-tabs {
        display: flex;
        gap: 0.25rem;
        padding: 0.75rem 1.5rem;
        overflow-x: auto;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .picker-tabs::-webkit-scrollbar { height: 0; }

    .picker-tab {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 20px;
        color: var(--text-secondary);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.35rem 0.8rem;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .picker-tab:hover { border-color: rgba(230,57,70,0.3); color: var(--text-primary); }

    .picker-tab.active {
        background: rgba(230,57,70,0.12);
        border-color: rgba(230,57,70,0.3);
        color: var(--accent);
    }

    /* Search */
    .picker-search {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .picker-search i { color: var(--text-secondary); font-size: 0.9rem; }

    .picker-search-input {
        background: none;
        border: none;
        color: var(--text-primary);
        font-size: 0.9rem;
        flex: 1;
        outline: none;
    }

    .picker-search-input::placeholder { color: var(--text-dim, #4a4a5e); }

    /* Exercise list */
    .picker-list {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem 1.5rem;
        max-height: 320px;
    }

    .picker-list::-webkit-scrollbar { width: 4px; }
    .picker-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

    .picker-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        border-bottom: 1px solid rgba(255,255,255,0.03);
    }

    .picker-item:hover { background: rgba(255,255,255,0.03); }

    .picker-item.selected { background: rgba(230,57,70,0.08); }

    .picker-checkbox {
        width: 20px;
        height: 20px;
        border-radius: 5px;
        border: 2px solid rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.2s;
        font-size: 0.65rem;
        color: transparent;
    }

    .picker-item.selected .picker-checkbox {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
    }

    .picker-item-info { flex: 1; }

    .picker-item-name { font-size: 0.9rem; font-weight: 600; color: var(--text-primary); }

    .picker-item-meta {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.15rem;
    }

    .picker-item-tag {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
    }

    .picker-item-type {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.1rem 0.4rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        color: var(--text-secondary);
    }

    /* No results */
    .picker-no-results {
        text-align: center;
        color: var(--text-secondary);
        padding: 2rem;
        font-size: 0.9rem;
    }

    /* Custom exercise input */
    .picker-custom {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.04);
    }

    .picker-custom-input {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        color: var(--text-primary);
        font-size: 0.85rem;
        flex: 1;
    }

    .picker-custom-input:focus { outline: none; border-color: rgba(230,57,70,0.3); }
    .picker-custom-input::placeholder { color: var(--text-dim, #4a4a5e); }

    /* Footer */
    .picker-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.06);
        background: rgba(0,0,0,0.2);
    }

    .picker-selected-count {
        font-size: 0.8rem;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ===== FINISH OVERLAY ===== */
    .finish-overlay {
        position: fixed;
        inset: 0;
        background: rgba(8,8,14,0.97);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        overflow-y: auto;
    }

    .finish-overlay.active {
        opacity: 1;
        pointer-events: all;
    }

    .finish-bg-glow {
        position: fixed;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0;
        transition: opacity 1s ease;
    }

    .finish-overlay.active .finish-bg-glow { opacity: 1; }

    .finish-bg-glow--1 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(230,57,70,0.15), transparent 70%);
        top: -100px;
        right: -100px;
    }

    .finish-bg-glow--2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(34,197,94,0.1), transparent 70%);
        bottom: -80px;
        left: -80px;
    }

    .finish-content {
        position: relative;
        z-index: 1;
        width: 90%;
        max-width: 600px;
        padding: 3rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
    }

    .finish-trophy {
        font-size: 3.5rem;
        margin-bottom: 0.5rem;
        opacity: 0;
        transform: scale(0.3) rotateZ(-15deg);
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .finish-trophy.visible {
        opacity: 1;
        transform: scale(1) rotateZ(0deg);
    }

    .finish-heading {
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        text-align: center;
        margin-bottom: 2rem;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.5s ease;
    }

    .finish-heading.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .finish-stat-row {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.9rem 1.25rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 10px;
        margin-bottom: 0.6rem;
        opacity: 0;
        transform: translateX(-30px);
        transition: all 0.4s ease;
    }

    .finish-stat-row.visible {
        opacity: 1;
        transform: translateX(0);
    }

    .finish-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: rgba(230,57,70,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        color: var(--accent);
        flex-shrink: 0;
    }

    .finish-stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
    }

    .finish-stat-value {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-primary);
    }

    .finish-stat-info { flex: 1; }

    .finish-divider {
        width: 60%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        margin: 1.2rem 0;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .finish-divider.visible { opacity: 1; }

    .finish-exercise-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin-bottom: 0.8rem;
        align-self: flex-start;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.4s ease;
    }

    .finish-exercise-title.visible {
        opacity: 1;
