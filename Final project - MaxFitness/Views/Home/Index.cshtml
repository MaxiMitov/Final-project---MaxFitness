                <line x1="20" y1="250" x2="480" y2="250" stroke="rgba(230,57,70,0.05)" stroke-width="1" />
                <!-- Corner brackets -->
                <path d="M60,60 L60,100" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M60,60 L100,60" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M440,60 L440,100" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M440,60 L400,60" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M60,440 L60,400" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M60,440 L100,440" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M440,440 L440,400" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <path d="M440,440 L400,440" fill="none" stroke="rgba(230,57,70,0.15)" stroke-width="2" />
                <!-- Rotating ring -->
                <circle cx="250" cy="250" r="200" fill="none" stroke="rgba(255,107,53,0.12)" stroke-width="1.5" stroke-dasharray="20 10 5 10" class="hud-ring-rotate" />
                <!-- Data points -->
                <circle cx="250" cy="50" r="4" fill="rgba(230,57,70,0.3)" class="hud-pulse" />
                <circle cx="450" cy="250" r="4" fill="rgba(255,107,53,0.3)" class="hud-pulse" style="animation-delay: 0.5s" />
                <circle cx="250" cy="450" r="4" fill="rgba(255,209,102,0.3)" class="hud-pulse" style="animation-delay: 1s" />
