@{
    var muscleName = ViewBag.MuscleName ?? "Muscle";
    ViewData["Title"] = muscleName + " Performance";
    var muscle = ViewBag.Muscle as Final_project___MaxFitness.Models.MuscleProgress;
    var currentPR = muscle?.CurrentPR ?? "No data";
    var progressPct = muscle?.ProgressPercentage ?? 0;
    var exercises = ViewBag.Exercises as List<Final_project___MaxFitness.Models.ExerciseDetail>;
    var weeklySets = muscle?.WeeklySets ?? 0;
    var recoveryStatus = muscle?.RecoveryStatus ?? "Unknown";
    var nextSession = muscle?.NextSession ?? "N/A";
    var totalExercises = muscle?.TotalExercises ?? 0;
    var compoundCount = muscle?.CompoundCount ?? 0;
    var isolationCount = muscle?.IsolationCount ?? 0;
    var bodyweightCount = muscle?.BodyweightCount ?? 0;
    var personalRecords = muscle?.PersonalRecords ?? new List<Final_project___MaxFitness.Models.PersonalRecord>();
    var monthlyProgress = muscle?.MonthlyProgress ?? new List<Final_project___MaxFitness.Models.WeeklyVolume>();
    var trendPct = muscle?.TrendPercent ?? "0";

    var recoveryBadgeClass = recoveryStatus switch {
        "Optimal" => "badge-recovery--good",
        "Almost Ready" => "badge-recovery--warn",
        "Recovering" => "badge-recovery--rest",
        _ => "badge-recovery--good"
    };
}

<style>
    .muscle-page { padding: 2rem 0 4rem; }
    .breadcrumb-nav { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; font-size: 0.85rem; }
    .breadcrumb-nav a { color: var(--text-secondary); text-decoration: none; transition: color 0.3s; }
    .breadcrumb-nav a:hover { color: var(--accent); }
    .breadcrumb-nav .separator { color: var(--text-secondary); opacity: 0.4; }
    .breadcrumb-nav .current { color: var(--text-primary); font-weight: 500; }

    .page-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 2.5rem; }
    .page-header-left h1 { font-size: 2.8rem; font-weight: 800; line-height: 1.1; margin-bottom: 0.75rem; }
    .page-header-left .subtitle { color: var(--text-secondary); font-size: 1.05rem; max-width: 520px; }
    .page-header-right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; padding-top: 0.5rem; }
    .badge-updated { background: var(--bg-card); border: 1px solid rgba(230,57,70,0.15); color: var(--text-secondary); padding: 0.4rem 1rem; border-radius: 2rem; font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem; }
    .badge-updated i { color: var(--accent); font-size: 0.7rem; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-bottom: 2.5rem; }
    .stat-item { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 1rem; padding: 1.5rem; transition: transform 0.3s, border-color 0.3s; }
    .stat-item:hover { transform: translateY(-3px); border-color: rgba(230,57,70,0.2); }
    .stat-item .stat-label { font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
    .stat-item .stat-label i { color: var(--accent); }
    .stat-item .stat-value { font-size: 1.85rem; font-weight: 700; line-height: 1.2; }
    .stat-item .stat-sub { font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.35rem; }
    .stat-progress-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; margin-top: 0.75rem; overflow: hidden; }
    .stat-progress-fill { height: 100%; background: var(--gradient-primary); border-radius: 3px; transition: width 1.2s ease; }

    .badge-recovery { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.7rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600; margin-left: 0.5rem; }
    .badge-recovery--good { background: rgba(46,204,113,0.12); color: #2ecc71; }
    .badge-recovery--warn { background: rgba(255,209,102,0.12); color: #ffd166; }
    .badge-recovery--rest { background: rgba(230,57,70,0.12); color: #e63946; }

    .muscle-main-content { display: grid; grid-template-columns: 1fr 380px; gap: 2rem; margin-bottom: 3rem; }

    .exercise-library-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .exercise-library-header h2 { font-size: 1.3rem; font-weight: 700; }
    .exercise-count { color: var(--text-secondary); font-size: 0.85rem; }

    .exercise-card { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 1rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; cursor: pointer; }
    .exercise-card:hover { transform: translateY(-2px); border-color: rgba(230,57,70,0.25); box-shadow: 0 8px 30px rgba(230,57,70,0.08); }
    .exercise-card-info { flex: 1; }
    .exercise-card-info .exercise-name { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text-primary); }
    .exercise-card-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
    .difficulty-badge { padding: 0.2rem 0.65rem; border-radius: 1rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
    .difficulty-beginner { background: rgba(46,204,113,0.12); color: #2ecc71; }
    .difficulty-intermediate { background: rgba(255,107,53,0.12); color: #ff6b35; }
    .difficulty-advanced { background: rgba(230,57,70,0.12); color: #e63946; }
    .exercise-meta-item { color: var(--text-secondary); font-size: 0.8rem; display: flex; align-items: center; gap: 0.3rem; }
    .exercise-meta-item i { font-size: 0.7rem; }
    .intensity-bar { display: flex; gap: 3px; align-items: center; }
    .intensity-segment { width: 16px; height: 5px; border-radius: 2px; background: rgba(255,255,255,0.08); }
    .intensity-segment.active { background: var(--accent); }
    .intensity-segment.active.mid { background: var(--accent-secondary); }
    .intensity-segment.active.low { background: var(--accent-tertiary); }
    .btn-start-sm { background: transparent; border: 1px solid rgba(230,57,70,0.3); color: var(--accent); padding: 0.4rem 1rem; border-radius: 0.5rem; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.3s; white-space: nowrap; text-decoration: none; }
    .btn-start-sm:hover { background: var(--accent); color: #fff; border-color: var(--accent); }

    .exercise-placeholder { background: var(--bg-card); border: 1px dashed rgba(255,255,255,0.08); border-radius: 1rem; padding: 3rem 2rem; text-align: center; color: var(--text-secondary); }
    .exercise-placeholder i { font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.3; display: block; }

    .sidebar-panel { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 1rem; padding: 1.5rem; margin-bottom: 1.25rem; }
    .sidebar-panel h3 { font-size: 1rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .sidebar-panel h3 i { color: var(--accent); font-size: 0.9rem; }

    .muscle-visual { display: flex; justify-content: center; align-items: center; padding: 1.5rem 0; margin-bottom: 1rem; }
    .muscle-visual svg { filter: drop-shadow(0 0 20px rgba(230,57,70,0.15)); }

    .muscle-facts { list-style: none; padding: 0; margin: 0; }
    .muscle-facts li { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 0.85rem; }
    .muscle-facts li:last-child { border-bottom: none; }
    .muscle-facts .fact-label { color: var(--text-secondary); }
    .muscle-facts .fact-value { color: var(--text-primary); font-weight: 600; }

    .tip-item { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem; }
    .tip-item:last-child { margin-bottom: 0; }
    .tip-icon { width: 22px; height: 22px; min-width: 22px; border-radius: 50%; background: rgba(230,57,70,0.12); display: flex; align-items: center; justify-content: center; margin-top: 2px; }
    .tip-icon i { color: var(--accent); font-size: 0.6rem; }
    .tip-text { color: var(--text-secondary); font-size: 0.85rem; line-height: 1.5; }

    .pr-timeline { position: relative; padding-left: 1.5rem; }
    .pr-timeline::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; background: rgba(230,57,70,0.2); border-radius: 1px; }
    .pr-entry { position: relative; margin-bottom: 1.1rem; }
    .pr-entry:last-child { margin-bottom: 0; }
    .pr-entry::before { content: ''; position: absolute; left: -1.5rem; top: 6px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--accent); background: var(--bg-card); z-index: 1; }
    .pr-entry:first-child::before { background: var(--accent); }
    .pr-weight { font-size: 0.95rem; font-weight: 600; color: var(--text-primary); }
    .pr-date { font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.1rem; }
    .pr-empty { color: var(--text-secondary); font-size: 0.85rem; text-align: center; padding: 1rem 0; }

    .chart-section { margin-bottom: 3rem; }
    .chart-section h2 { font-size: 1.3rem; font-weight: 700; margin-bottom: 1.5rem; }
    .chart-container { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 1rem; padding: 2rem; }
    .chart-bars { display: flex; align-items: flex-end; justify-content: space-around; height: 200px; gap: 1.5rem; padding: 0 1rem; }
    .chart-bar-group { display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; justify-content: flex-end; }
    .mp-chart-bar { width: 100%; max-width: 80px; border-radius: 0.5rem 0.5rem 0 0; background: var(--gradient-primary); position: relative; transition: height 1s ease; min-height: 4px; }
    .mp-chart-bar::after { content: attr(data-value); position: absolute; top: -1.6rem; left: 50%; transform: translateX(-50%); font-size: 0.75rem; font-weight: 600; color: var(--text-primary); white-space: nowrap; }
    .mp-chart-bar--empty { background: rgba(255,255,255,0.04); }
    .chart-bar-label { margin-top: 0.75rem; font-size: 0.8rem; color: var(--text-secondary); }
    .chart-legend { display: flex; justify-content: center; gap: 2rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.04); }
    .chart-legend-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-secondary); }
    .chart-legend-dot { width: 10px; height: 10px; border-radius: 3px; background: var(--gradient-primary); }
    .trend-badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.7rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 600; margin-left: 0.75rem; }
    .trend-badge--up { background: rgba(46,204,113,0.12); color: #2ecc71; }
    .trend-badge--down { background: rgba(230,57,70,0.12); color: #e63946; }
    .trend-badge--flat { background: rgba(255,255,255,0.06); color: var(--text-secondary); }
    .chart-empty { text-align: center; padding: 3rem 2rem; color: var(--text-secondary); }
    .chart-empty i { font-size: 2rem; opacity: 0.3; margin-bottom: 0.75rem; display: block; }

    .bottom-cta { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 1.25rem; padding: 3rem; text-align: center; position: relative; overflow: hidden; }
    .bottom-cta::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--gradient-primary); }
    .bottom-cta h2 { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.75rem; font-size: 0.95rem; }
    .bottom-cta-buttons { display: flex; justify-content: center; gap: 1rem; }

    @@media (max-width: 992px) {
        .muscle-main-content { grid-template-columns: 1fr; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .page-header { flex-direction: column; }
    }
    @@media (max-width: 576px) {
        .stats-grid { grid-template-columns: 1fr; }
        .page-header-left h1 { font-size: 2rem; }
        .chart-bars { height: 150px; gap: 0.75rem; }
        .bottom-cta-buttons { flex-direction: column; align-items: center; }
    }
</style>

<section class="muscle-page">
    <div class="container">

        <!-- Breadcrumb -->
        <nav class="breadcrumb-nav reveal">
            <a asp-action="Index"><i class="fas fa-th-large"></i> Dashboard</a>
            <span class="separator"><i class="fas fa-chevron-right"></i></span>
            <span class="current">@muscleName</span>
        </nav>

        <!-- Page Header -->
        <div class="page-header reveal reveal-up">
            <div class="page-header-left">
                <h1>
                    <span class="text-gradient">@muscleName</span> Performance
                </h1>
                <p class="subtitle">
                    In-depth analysis and tracking for your @muscleName.ToString().ToLower() development
                </p>
            </div>
            <div class="page-header-right">
                <span class="badge-updated">
                    <i class="fas fa-circle"></i> Live Data
                </span>
                <a asp-controller="Workout" asp-action="Index" class="btn-accent" style="padding: 0.6rem 1.5rem; border-radius: 0.6rem; font-weight: 600; text-decoration: none;">
                    <i class="fas fa-plus"></i> Log Workout
                </a>
            </div>
        </div>

        <!-- Stats Overview -->
        <div class="stats-grid reveal reveal-up">
            <div class="stat-item">
                <div class="stat-label">
                    <i class="fas fa-trophy"></i> Current PR
                </div>
                <div class="stat-value text-gradient">@currentPR</div>
                <div class="stat-sub">Best volume in a single exercise</div>
            </div>

            <div class="stat-item">
                <div class="stat-label">
                    <i class="fas fa-chart-line"></i> Progress
                </div>
                <div class="stat-value">@progressPct<span style="font-size: 1rem; color: var(--text-secondary);">%</span></div>
                <div class="stat-progress-bar">
                    <div class="stat-progress-fill" style="width: @(progressPct)%;"></div>
                </div>
                <div class="stat-sub">Based on @(progressPct / 10) sessions logged</div>
            </div>

            <div class="stat-item">
                <div class="stat-label">
                    <i class="fas fa-layer-group"></i> Weekly Volume
                </div>
                <div class="stat-value">@weeklySets <span style="font-size: 1rem; color: var(--text-secondary);">Sets</span></div>
                <div class="stat-sub">This week</div>
            </div>

            <div class="stat-item">
                <div class="stat-label">
                    <i class="fas fa-heart-pulse"></i> Recovery
                </div>
                <div class="stat-value">
                    @recoveryStatus
                    <span class="badge-recovery @recoveryBadgeClass"><i class="fas fa-check"></i> @recoveryStatus</span>
                </div>
                <div class="stat-sub">Next session: @nextSession</div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="muscle-main-content">

            <!-- Left: Exercise Library -->
            <div class="left-column">
                <div class="exercise-library-header reveal">
                    <h2><i class="fas fa-dumbbell" style="color: var(--accent); margin-right: 0.5rem;"></i> Recommended Exercises</h2>
                    @if (exercises != null)
                    {
                        <span class="exercise-count">@exercises.Count exercises</span>
                    }
                </div>

                @if (exercises != null && exercises.Count > 0)
                {
                    @foreach (var exercise in exercises)
                    {
                        var difficultyStr = (exercise.Difficulty ?? "Beginner").ToLower();
                        var difficultyClass = difficultyStr == "advanced" ? "difficulty-advanced"
                            : difficultyStr == "intermediate" ? "difficulty-intermediate"
                            : "difficulty-beginner";

                        <div class="exercise-card reveal reveal-up">
                            <div class="exercise-card-info">
                                <div class="exercise-name">@exercise.Name</div>
                                <div class="exercise-card-meta">
                                    <span class="difficulty-badge @difficultyClass">@exercise.Difficulty</span>
                                    <span class="exercise-meta-item">
                                        <i class="fas fa-repeat"></i> @exercise.TargetReps
                                    </span>
                                    <span class="exercise-meta-item">
                                        <i class="fas fa-fire"></i> @exercise.Intensity
                                    </span>
                                </div>
                            </div>
                            <a asp-controller="Workout" asp-action="Index" class="btn-start-sm"><i class="fas fa-play"></i> Start</a>
                        </div>
                    }
                }
                else
                {
                    <div class="exercise-placeholder reveal">
                        <i class="fas fa-dumbbell"></i>
                        <p style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">No exercises found</p>
                        <p>No exercises are available for @muscleName yet.</p>
                    </div>
                }
            </div>

            <!-- Right: Sidebar -->
            <div class="right-column">

                <!-- Muscle Overview -->
                <div class="sidebar-panel reveal reveal-up">
                    <h3><i class="fas fa-crosshairs"></i> Muscle Overview</h3>

                    <div class="muscle-visual">
                        @switch (muscleName.ToString().ToLower())
                        {
                            case "chest":
                                <svg width="160" height="120" viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="10" y="20" width="65" height="75" rx="20" fill="url(#chestGrad)" opacity="0.85"/>
                                    <rect x="85" y="20" width="65" height="75" rx="20" fill="url(#chestGrad)" opacity="0.85"/>
                                    <line x1="80" y1="25" x2="80" y2="90" stroke="#08080d" stroke-width="3" stroke-linecap="round"/>
                                    <defs><linearGradient id="chestGrad" x1="0" y1="0" x2="160" y2="120"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            case "back":
                                <svg width="160" height="130" viewBox="0 0 160 130" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M30 15 Q80 5 130 15 L140 100 Q80 115 20 100 Z" fill="url(#backGrad)" opacity="0.85"/>
                                    <line x1="80" y1="10" x2="80" y2="105" stroke="#08080d" stroke-width="3" stroke-linecap="round"/>
                                    <defs><linearGradient id="backGrad" x1="0" y1="0" x2="160" y2="130"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            case "legs":
                                <svg width="140" height="140" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="15" y="10" width="45" height="120" rx="16" fill="url(#legsGrad)" opacity="0.85"/>
                                    <rect x="80" y="10" width="45" height="120" rx="16" fill="url(#legsGrad)" opacity="0.85"/>
                                    <defs><linearGradient id="legsGrad" x1="0" y1="0" x2="140" y2="140"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            case "arms": case "biceps": case "triceps":
                                <svg width="150" height="120" viewBox="0 0 150 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <ellipse cx="42" cy="60" rx="28" ry="45" fill="url(#armsGrad)" opacity="0.85"/>
                                    <ellipse cx="108" cy="60" rx="28" ry="45" fill="url(#armsGrad)" opacity="0.85"/>
                                    <defs><linearGradient id="armsGrad" x1="0" y1="0" x2="150" y2="120"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            case "shoulders":
                                <svg width="160" height="100" viewBox="0 0 160 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <ellipse cx="40" cy="50" rx="35" ry="30" fill="url(#shoulderGrad)" opacity="0.85"/>
                                    <ellipse cx="120" cy="50" rx="35" ry="30" fill="url(#shoulderGrad)" opacity="0.85"/>
                                    <defs><linearGradient id="shoulderGrad" x1="0" y1="0" x2="160" y2="100"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            case "abs":
                                <svg width="100" height="140" viewBox="0 0 100 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="10" y="10" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.85"/>
                                    <rect x="55" y="10" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.85"/>
                                    <rect x="10" y="50" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.85"/>
                                    <rect x="55" y="50" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.85"/>
                                    <rect x="10" y="90" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.75"/>
                                    <rect x="55" y="90" width="35" height="30" rx="8" fill="url(#absGrad)" opacity="0.75"/>
                                    <defs><linearGradient id="absGrad" x1="0" y1="0" x2="100" y2="140"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                            default:
                                <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle cx="60" cy="60" r="50" fill="url(#defaultGrad)" opacity="0.85"/>
                                    <defs><linearGradient id="defaultGrad" x1="0" y1="0" x2="120" y2="120"><stop offset="0%" stop-color="#e63946"/><stop offset="100%" stop-color="#ff6b35"/></linearGradient></defs>
                                </svg>
                                break;
                        }
                    </div>

                    <ul class="muscle-facts">
                        <li>
                            <span class="fact-label">Total Exercises</span>
                            <span class="fact-value">@totalExercises</span>
                        </li>
                        <li>
                            <span class="fact-label">Compound Movements</span>
                            <span class="fact-value">@compoundCount</span>
                        </li>
                        <li>
                            <span class="fact-label">Isolation Exercises</span>
                            <span class="fact-value">@isolationCount</span>
                        </li>
                        @if (bodyweightCount > 0)
                        {
                            <li>
                                <span class="fact-label">Bodyweight Exercises</span>
                                <span class="fact-value">@bodyweightCount</span>
                            </li>
                        }
                        <li>
                            <span class="fact-label">Recommended Weekly Sets</span>
                            <span class="fact-value">12-16</span>
                        </li>
                    </ul>
                </div>

                <!-- Training Tips -->
                <div class="sidebar-panel reveal reveal-up">
                    <h3><i class="fas fa-lightbulb"></i> Training Tips</h3>
                    <div class="tip-item">
                        <div class="tip-icon"><i class="fas fa-check"></i></div>
                        <div class="tip-text">Focus on mind-muscle connection during every rep to maximize fiber recruitment and growth stimulus.</div>
                    </div>
                    <div class="tip-item">
                        <div class="tip-icon"><i class="fas fa-check"></i></div>
                        <div class="tip-text">Progressive overload is key. Increase weight, reps, or sets each week to drive consistent adaptation.</div>
                    </div>
                    <div class="tip-item">
                        <div class="tip-icon"><i class="fas fa-check"></i></div>
                        <div class="tip-text">Allow 48 hours recovery between sessions targeting the same muscle group for optimal repair and growth.</div>
                    </div>
                </div>

                <!-- Personal Records -->
                <div class="sidebar-panel reveal reveal-up">
                    <h3><i class="fas fa-medal"></i> Personal Records</h3>

                    @if (personalRecords.Count > 0)
                    {
                        <div class="pr-timeline">
                            @foreach (var pr in personalRecords)
                            {
                                <div class="pr-entry">
                                    <div class="pr-weight">@pr.Weight</div>
                                    <div class="pr-date">@pr.Date</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="pr-empty">
                            <i class="fas fa-medal" style="opacity: 0.3; margin-right: 0.3rem;"></i>
                            No records yet. Start training to set your first PR!
                        </p>
                    }
                </div>

            </div>
        </div>

        <!-- Monthly Progress Chart -->
        <div class="chart-section reveal reveal-up">
            <h2>
                <i class="fas fa-chart-bar" style="color: var(--accent); margin-right: 0.5rem;"></i>
                Monthly Progress
                @{
                    var trendClass = trendPct.StartsWith("+") ? "trend-badge--up" : trendPct.StartsWith("-") ? "trend-badge--down" : "trend-badge--flat";
                    var trendIcon = trendPct.StartsWith("+") ? "fa-arrow-trend-up" : trendPct.StartsWith("-") ? "fa-arrow-trend-down" : "fa-minus";
                }
                <span class="trend-badge @trendClass"><i class="fas @trendIcon"></i> @(trendPct)%</span>
            </h2>

            @if (monthlyProgress.Any(w => w.Sets > 0))
            {
                <div class="chart-container">
                    <div class="chart-bars">
                        @foreach (var week in monthlyProgress)
                        {
                            var barClass = week.Sets > 0 ? "mp-chart-bar" : "mp-chart-bar mp-chart-bar--empty";
                            var barHeight = week.Sets > 0 ? week.HeightPercent : 4;
                            <div class="chart-bar-group">
                                <div class="@barClass" style="height: @(barHeight)%;" data-value="@week.Sets sets"></div>
                                <div class="chart-bar-label">@week.Label</div>
                            </div>
                        }
                    </div>
                    <div class="chart-legend">
                        <div class="chart-legend-item">
                            <span class="chart-legend-dot"></span> Total Sets per Week
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="chart-container">
                    <div class="chart-empty">
                        <i class="fas fa-chart-bar"></i>
                        <p style="font-weight: 600; color: var(--text-primary); margin-bottom: 0.25rem;">No training data yet</p>
                        <p>Complete workouts targeting @muscleName.ToString().ToLower() to see your weekly progress here.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Bottom CTA -->
        <div class="bottom-cta reveal reveal-up">
            <h2>Ready for your next <span class="text-gradient">@muscleName</span> session?</h2>
            <p>Push past your limits and set a new personal record today.</p>
            <div class="bottom-cta-buttons">
                <a asp-controller="Workout" asp-action="Index" class="btn-accent" style="padding: 0.75rem 2.5rem; border-radius: 0.6rem; font-size: 1rem; font-weight: 700; text-decoration: none;">
                    <i class="fas fa-bolt"></i> Start Workout
                </a>
                <a asp-action="Index" class="btn-ghost" style="padding: 0.75rem 2rem; border-radius: 0.6rem; font-size: 1rem; font-weight: 600; text-decoration: none;">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

    </div>
</section>
