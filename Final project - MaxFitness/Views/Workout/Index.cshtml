</style>


@section Scripts {
<script>
    // ===== STATE =====
    var exercises = [];          // active exercises in the workout
    var allDbExercises = [];     // all exercises from DB (loaded once)
    var pickerSelected = [];     // temp selection in the picker modal
    var pickerFilter = 'all';
    var timerInterval = null;
    var timerSeconds = 0;
    var timerRunning = false;

    // ===== LOAD ALL EXERCISES FROM DB =====
    (function loadAllExercises() {
        var muscles = ['chest','back','shoulders','biceps','triceps','legs','abs','forearms'];
        var promises = muscles.map(function(m) {
            return fetch('/Workout/GetExercises?muscleGroup=' + m)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    return data.map(function(ex) {
                        return { name: ex.name, type: ex.type, muscle: m };
                    });
                });
        });
        Promise.all(promises).then(function(results) {
            allDbExercises = results.flat();
        });
    })();

    // ===== TIMER =====
    function toggleTimer() {
        if (timerRunning) {
            clearInterval(timerInterval);
            timerRunning = false;
            document.getElementById('timerIcon').className = 'fa-solid fa-play';
            document.getElementById('timerBtnText').textContent = 'Resume';
        } else {
            timerInterval = setInterval(function() {
                timerSeconds++;
                var mins = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                var secs = (timerSeconds % 60).toString().padStart(2, '0');
                document.getElementById('timerValue').textContent = mins + ':' + secs;
            }, 1000);
            timerRunning = true;
            document.getElementById('timerIcon').className = 'fa-solid fa-pause';
            document.getElementById('timerBtnText').textContent = 'Pause';
        }
    }

    // ===== BODY MAP CLICK =====
    document.querySelectorAll('.wk-muscle').forEach(function(el) {
        el.addEventListener('click', function() {
            var muscle = this.getAttribute('data-muscle');
            openExercisePicker(muscle);
        });
    });

    // ===== EXERCISE PICKER =====
    function openExercisePicker(muscle) {
        pickerSelected = [];
        pickerFilter = muscle || 'all';

        // Set active tab
        document.querySelectorAll('.picker-tab').forEach(function(t) {
            t.classList.toggle('active', t.getAttribute('data-filter') === pickerFilter);
        });

        document.getElementById('pickerSearch').value = '';
        renderPickerList();
        updatePickerCount();
        document.getElementById('exercisePickerModal').classList.add('active');
    }

    function closePickerModal() {
        document.getElementById('exercisePickerModal').classList.remove('active');
    }

    function filterPickerTab(btn) {
        document.querySelectorAll('.picker-tab').forEach(function(t) { t.classList.remove('active'); });
        btn.classList.add('active');
        pickerFilter = btn.getAttribute('data-filter');
        renderPickerList();
    }

    function filterPickerList() {
        renderPickerList();
    }

    function renderPickerList() {
        var list = document.getElementById('pickerList');
        var search = document.getElementById('pickerSearch').value.toLowerCase().trim();

        // Get already-added exercise names
        var addedNames = exercises.map(function(e) { return e.name.toLowerCase(); });

        var filtered = allDbExercises.filter(function(ex) {
            if (pickerFilter !== 'all' && ex.muscle !== pickerFilter) return false;
            if (search && ex.name.toLowerCase().indexOf(search) === -1) return false;
            return true;
        });

        if (filtered.length === 0) {
            list.innerHTML = '<div class="picker-no-results">No exercises found</div>';
            return;
        }

        list.innerHTML = '';
        filtered.forEach(function(ex) {
            var isAdded = addedNames.indexOf(ex.name.toLowerCase()) >= 0;
            var isSelected = pickerSelected.some(function(s) { return s.name === ex.name; });

            var item = document.createElement('div');
            item.className = 'picker-item' + (isSelected ? ' selected' : '');
            if (isAdded) item.style.opacity = '0.4';

            item.innerHTML =
                '<div class="picker-checkbox"><i class="fa-solid fa-check"></i></div>' +
                '<div class="picker-item-info">' +
                    '<div class="picker-item-name">' + ex.name + (isAdded ? ' <span style="font-size:0.65rem;color:var(--text-secondary)">(already added)</span>' : '') + '</div>' +
                    '<div class="picker-item-meta">' +
                        '<span class="picker-item-tag">' + ex.muscle + '</span>' +
                        '<span class="picker-item-type">' + ex.type + '</span>' +
                    '</div>' +
                '</div>';

            if (!isAdded) {
                item.addEventListener('click', function() {
                    togglePickerItem(ex, item);
                });
            }

            list.appendChild(item);
        });
    }

    function togglePickerItem(ex, element) {
        var idx = pickerSelected.findIndex(function(s) { return s.name === ex.name; });
        if (idx >= 0) {
            pickerSelected.splice(idx, 1);
            element.classList.remove('selected');
        } else {
            pickerSelected.push(ex);
            element.classList.add('selected');
        }
        updatePickerCount();
    }

    function updatePickerCount() {
        document.getElementById('pickerSelectedCount').textContent = pickerSelected.length + ' selected';
    }

    function confirmPickerSelection() {
        pickerSelected.forEach(function(ex) {
            exercises.push({
                name: ex.name,
                type: ex.type,
                muscle: ex.muscle,
                sets: [{ reps: '', weight: '' }]
            });
        });
        closePickerModal();
        renderExercises();
        updateBodyMap();
        updateSummary();
        showSummaryIfNeeded();

        if (!timerRunning && timerSeconds === 0 && exercises.length > 0) {
            toggleTimer();
        }
    }

    function addCustomFromPicker() {
        var input = document.getElementById('customExerciseName');
        var name = input.value.trim();
        if (!name) return;

        exercises.push({
            name: name,
            type: 'Custom',
            muscle: pickerFilter !== 'all' ? pickerFilter : 'other',
            sets: [{ reps: '', weight: '' }]
        });
        input.value = '';
        closePickerModal();
        renderExercises();
        updateBodyMap();
        updateSummary();
        showSummaryIfNeeded();

        if (!timerRunning && timerSeconds === 0) {
            toggleTimer();
        }
    }

    // Close on overlay click
    document.getElementById('exercisePickerModal').addEventListener('click', function(e) {
        if (e.target === this) closePickerModal();
    });

    // Enter key in custom input
    document.getElementById('customExerciseName').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') addCustomFromPicker();
    });

    // ===== RENDER ACTIVE EXERCISES =====
    function renderExercises() {
        var log = document.getElementById('exerciseLog');
        var empty = document.getElementById('exerciseEmpty');
        log.innerHTML = '';

        if (exercises.length === 0) {
            empty.style.display = 'block';
            return;
        }
        empty.style.display = 'none';

        exercises.forEach(function(exercise, exIndex) {
            var item = document.createElement('div');
            item.className = 'exercise-item';

            var setsHTML = '';
            exercise.sets.forEach(function(set, setIndex) {
                setsHTML += '<div class="set-row">' +
                    '<span class="set-number">' + (setIndex + 1) + '</span>' +
                    '<input type="number" class="set-input" placeholder="kg" value="' + (set.weight || '') + '" ' +
                        'onchange="updateSet(' + exIndex + ',' + setIndex + ',\'weight\',this.value)" ' +
                        'oninput="updateSet(' + exIndex + ',' + setIndex + ',\'weight\',this.value)" />' +
                    '<input type="number" class="set-input" placeholder="reps" value="' + (set.reps || '') + '" ' +
                        'onchange="updateSet(' + exIndex + ',' + setIndex + ',\'reps\',this.value)" ' +
                        'oninput="updateSet(' + exIndex + ',' + setIndex + ',\'reps\',this.value)" />' +
                    '<button class="set-remove-btn" onclick="removeSet(' + exIndex + ',' + setIndex + ')" title="Remove set">' +
                        '<i class="fa-solid fa-xmark"></i>' +
                    '</button>' +
                '</div>';
            });

            item.innerHTML =
                '<div class="exercise-item-header">' +
                    '<div class="exercise-item-name">' +
                        '<i class="fa-solid fa-dumbbell"></i> ' + exercise.name +
                        ' <span class="exercise-muscle-tag">' + (exercise.muscle || '') + '</span>' +
                    '</div>' +
                    '<div class="exercise-item-actions">' +
                        '<span class="exercise-item-badge">' + exercise.type + '</span>' +
                        '<button class="exercise-remove-btn" onclick="removeExercise(' + exIndex + ')" title="Remove">' +
                            '<i class="fa-solid fa-trash"></i>' +
                        '</button>' +
                    '</div>' +
                '</div>' +
                '<div class="sets-table">' +
                    '<div class="sets-table-header">' +
                        '<span>Set</span><span>Weight (kg)</span><span>Reps</span><span></span>' +
                    '</div>' +
                    setsHTML +
                    '<button class="add-set-btn" onclick="addSet(' + exIndex + ')">' +
                        '<i class="fa-solid fa-plus"></i> Add Set' +
                    '</button>' +
                '</div>';

            log.appendChild(item);
        });
    }

    // ===== SET MANAGEMENT =====
    function addSet(exIndex) {
        exercises[exIndex].sets.push({ reps: '', weight: '' });
        renderExercises();
    }

    function removeSet(exIndex, setIndex) {
        if (exercises[exIndex].sets.length > 1) {
            exercises[exIndex].sets.splice(setIndex, 1);
            renderExercises();
        }
    }

    function updateSet(exIndex, setIndex, field, value) {
        exercises[exIndex].sets[setIndex][field] = value;
        updateSummary();
    }

    function removeExercise(exIndex) {
        exercises.splice(exIndex, 1);
        renderExercises();
        updateBodyMap();
        updateSummary();
        if (exercises.length === 0) {
            document.getElementById('summarySection').style.display = 'none';
        }
    }

    // ===== BODY MAP HIGHLIGHTING =====
    function updateBodyMap() {
        // Get unique active muscles
        var activeMuscles = {};
        exercises.forEach(function(ex) {
            if (ex.muscle) activeMuscles[ex.muscle] = true;
        });

        document.querySelectorAll('.wk-muscle').forEach(function(el) {
            var muscle = el.getAttribute('data-muscle');
            if (activeMuscles[muscle]) {
                el.classList.add('wk-active');
            } else {
                el.classList.remove('wk-active');
            }
        });
    }

    function showSummaryIfNeeded() {
        if (exercises.length > 0) {
            document.getElementById('summarySection').style.display = 'block';
        }
    }

    // ===== INTENSITY ALGORITHM =====
    function calculateIntensity() {
        var totalSets = 0;
        var totalReps = 0;
        var totalVolume = 0;
        var filledSets = 0;
        var exerciseCount = exercises.length;

        exercises.forEach(function(ex) {
            ex.sets.forEach(function(set) {
                var reps = parseInt(set.reps) || 0;
                var weight = parseFloat(set.weight) || 0;
                if (reps > 0) {
                    totalSets++;
                    totalReps += reps;
                    totalVolume += reps * weight;
                    filledSets++;
                }
            });
        });

        if (filledSets === 0) return { score: 0, totalSets: 0, totalReps: 0, totalVolume: 0 };

        var durationMins = Math.max(timerSeconds / 60, 1);
        var volumePerMin = totalVolume / durationMins;
        var volumeScore = Math.min(35, (volumePerMin / 50) * 35);
        var setsPerMin = totalSets / durationMins;
        var densityScore = Math.min(25, (setsPerMin / 0.5) * 25);
        var rawVolumeScore = Math.min(20, (totalVolume / 5000) * 20);
        var varietyScore = Math.min(10, (exerciseCount / 6) * 10);
        var avgReps = totalReps / Math.max(totalSets, 1);
        var repScore = Math.min(10, (avgReps / 12) * 10);

        var score = Math.round(volumeScore + densityScore + rawVolumeScore + varietyScore + repScore);
        return { score: Math.min(100, Math.max(0, score)), totalSets: totalSets, totalReps: totalReps, totalVolume: totalVolume };
    }

    // ===== UPDATE SUMMARY =====
    function updateSummary() {
        var result = calculateIntensity();
        var mins = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
        var secs = (timerSeconds % 60).toString().padStart(2, '0');
        document.getElementById('summaryDuration').textContent = mins + ':' + secs;
        document.getElementById('summaryTotalSets').textContent = result.totalSets;
        document.getElementById('summaryTotalReps').textContent = result.totalReps;
        document.getElementById('summaryVolume').innerHTML = result.totalVolume.toLocaleString() + ' <span class="summary-unit">kg</span>';

        var barEl = document.getElementById('intensityBar');
        var levelEl = document.getElementById('intensityLevel');
        document.getElementById('summaryIntensity').textContent = result.score + '%';
        barEl.style.width = result.score + '%';
        barEl.className = 'intensity-bar-fill';
        levelEl.className = 'intensity-level';

        if (result.score <= 25) { barEl.classList.add('intensity-low'); levelEl.classList.add('intensity-low'); levelEl.textContent = 'Light'; }
        else if (result.score <= 50) { barEl.classList.add('intensity-moderate'); levelEl.classList.add('intensity-moderate'); levelEl.textContent = 'Moderate'; }
        else if (result.score <= 75) { barEl.classList.add('intensity-high'); levelEl.classList.add('intensity-high'); levelEl.textContent = 'High'; }
        else { barEl.classList.add('intensity-extreme'); levelEl.classList.add('intensity-extreme'); levelEl.textContent = 'Extreme'; }
    }

    setInterval(updateSummary, 1000);

    // ===== FINISH WORKOUT =====
    function finishWorkout() {
        if (timerRunning) toggleTimer();
        var result = calculateIntensity();
        var mins = Math.floor(timerSeconds / 60);
        var secs = timerSeconds % 60;
        var durationText = mins + 'm ' + secs + 's';

        var content = document.getElementById('finishContent');
        content.innerHTML = '';

        var items = [];

        // Trophy icon
        var trophy = document.createElement('div');
        trophy.className = 'finish-trophy';
        trophy.innerHTML = '<i class="fa-solid fa-trophy" style="color: #ffd166;"></i>';
        content.appendChild(trophy);
        items.push(trophy);

        // Heading
        var heading = document.createElement('h2');
        heading.className = 'finish-heading';
        heading.innerHTML = 'WORKOUT <span class="text-gradient">COMPLETE</span>';
        content.appendChild(heading);
        items.push(heading);

        // Stats
        var stats = [
            { icon: 'fa-clock', label: 'Duration', value: durationText },
            { icon: 'fa-dumbbell', label: 'Total Sets', value: result.totalSets },
            { icon: 'fa-repeat', label: 'Total Reps', value: result.totalReps },
            { icon: 'fa-weight-hanging', label: 'Total Volume', value: result.totalVolume.toLocaleString() + ' kg' }
        ];

        stats.forEach(function(stat) {
            var row = document.createElement('div');
            row.className = 'finish-stat-row';
            row.innerHTML =
                '<div class="finish-stat-icon"><i class="fa-solid ' + stat.icon + '"></i></div>' +
                '<div class="finish-stat-info">' +
                    '<div class="finish-stat-label">' + stat.label + '</div>' +
                    '<div class="finish-stat-value">' + stat.value + '</div>' +
                '</div>';
            content.appendChild(row);
            items.push(row);
        });

        // Divider
        var divider = document.createElement('div');
        divider.className = 'finish-divider';
        content.appendChild(divider);
        items.push(divider);

        // Exercise breakdown title
        var exTitle = document.createElement('div');
        exTitle.className = 'finish-exercise-title';
        exTitle.textContent = 'Exercise Breakdown';
        content.appendChild(exTitle);
        items.push(exTitle);

        // Each exercise
        exercises.forEach(function(ex) {
            var filledSets = ex.sets.filter(function(s) { return parseInt(s.reps) > 0; });
            var setCount = filledSets.length || ex.sets.length;
            var totalReps = 0;
            var totalVol = 0;
            filledSets.forEach(function(s) {
                var r = parseInt(s.reps) || 0;
                var w = parseFloat(s.weight) || 0;
                totalReps += r;
                totalVol += r * w;
            });

            var row = document.createElement('div');
            row.className = 'finish-exercise-row';
            row.innerHTML =
                '<div class="finish-ex-name"><i class="fa-solid fa-chevron-right"></i> ' + ex.name + '</div>' +
                '<div class="finish-ex-detail">' + setCount + ' sets &middot; ' + totalReps + ' reps &middot; ' + totalVol.toLocaleString() + ' kg</div>';
            content.appendChild(row);
            items.push(row);
        });

        // Intensity bar
        var barWrap = document.createElement('div');
        barWrap.className = 'finish-intensity-bar';
        var barFill = document.createElement('div');
        barFill.className = 'finish-intensity-fill';
        if (result.score <= 25) barFill.classList.add('intensity-low');
        else if (result.score <= 50) barFill.classList.add('intensity-moderate');
        else if (result.score <= 75) barFill.classList.add('intensity-high');
        else barFill.classList.add('intensity-extreme');
        barWrap.appendChild(barFill);
        content.appendChild(barWrap);
        items.push(barWrap);

        // Intensity label
        var intensityLabel = document.createElement('div');
        intensityLabel.className = 'finish-intensity-label';
        var levelText = result.score <= 25 ? 'Light' : result.score <= 50 ? 'Moderate' : result.score <= 75 ? 'High' : 'Extreme';
        var levelColor = result.score <= 25 ? '#22c55e' : result.score <= 50 ? '#ffd166' : result.score <= 75 ? '#ff6b35' : '#e63946';
        intensityLabel.innerHTML = '<span style="color:' + levelColor + '">' + result.score + '% — ' + levelText + '</span>';
        content.appendChild(intensityLabel);
        items.push(intensityLabel);

        // Home button
        var homeBtn = document.createElement('a');
        homeBtn.href = '/';
        homeBtn.className = 'finish-home-btn';
        homeBtn.innerHTML = '<i class="fa-solid fa-house"></i> Go to Home';
        content.appendChild(homeBtn);
        items.push(homeBtn);

        // Show overlay
        document.getElementById('finishOverlay').classList.add('active');

        // Staggered reveal animation
        var delay = 200;
        items.forEach(function(el, i) {
            setTimeout(function() {
                el.classList.add('visible');

                // Trigger intensity bar fill after bar becomes visible
                if (el === barWrap) {
                    setTimeout(function() {
                        barFill.style.width = result.score + '%';
                    }, 100);
                }
            }, delay + (i * 180));
        });
    }

    // Close finish overlay on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.getElementById('finishOverlay').classList.remove('active');
        }
    });
</script>
}
