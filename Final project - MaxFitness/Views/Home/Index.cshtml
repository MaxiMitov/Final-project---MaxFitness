</style>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ===== BODY MAP INTERACTIVITY =====
            var muscleGroups = document.querySelectorAll('.muscle-group');
            var detailEmpty = document.getElementById('muscleDetailEmpty');
            var detailContent = document.getElementById('muscleDetailContent');
            var muscleName = document.getElementById('muscleName');
            var muscleStatus = document.getElementById('muscleStatus');
            var muscleLastTrained = document.getElementById('muscleLastTrained');
            var muscleExercises = document.getElementById('muscleExercises');
            var muscleTrainBtn = document.getElementById('muscleTrainBtn');

            var statusLabels = {
                'strong': 'Strong',
                'moderate': 'Moderate',
                'needs-work': 'Needs Work'
            };

            var statusClasses = {
                'strong': 'status--strong',
                'moderate': 'status--moderate',
                'needs-work': 'status--needs-work'
            };

            var muscleRoutes = {
                'Neck': '/Home/Shoulders',
                'Traps': '/Home/Back',
                'Left Shoulder': '/Home/Shoulders',
                'Right Shoulder': '/Home/Shoulders',
                'Chest (Left)': '/Home/Chest',
                'Chest (Right)': '/Home/Chest',
                'Left Bicep': '/Home/Biceps',
                'Right Bicep': '/Home/Biceps',
                'Left Forearm': '/Home/Forearms',
                'Right Forearm': '/Home/Forearms',
                'Abs': '/Home/Abs',
                'Left Oblique': '/Home/Abs',
                'Right Oblique': '/Home/Abs',
                'Left Quad': '/Home/Legs',
                'Right Quad': '/Home/Legs',
                'Left Calf': '/Home/Legs',
                'Right Calf': '/Home/Legs'
            };

            muscleGroups.forEach(function (muscle) {
                muscle.addEventListener('mouseenter', function () {
                    var name = this.getAttribute('data-muscle');
                    var status = this.getAttribute('data-status');
                    var lastTrained = this.getAttribute('data-last-trained');
                    var exercises = this.getAttribute('data-exercises');

                    detailEmpty.style.display = 'none';
                    detailContent.style.display = 'block';

                    muscleName.textContent = name;
                    muscleStatus.textContent = statusLabels[status] || status;
                    muscleStatus.className = 'muscle-detail-status ' + (statusClasses[status] || '');
                    muscleLastTrained.textContent = lastTrained;
                    muscleExercises.textContent = exercises;

                    if (muscleTrainBtn && muscleRoutes[name]) {
                        muscleTrainBtn.href = muscleRoutes[name];
                    }
                });

                muscle.addEventListener('mouseleave', function () {
                    detailEmpty.style.display = 'flex';
                    detailContent.style.display = 'none';
                });

                muscle.addEventListener('click', function () {
                    var name = this.getAttribute('data-muscle');
                    if (muscleRoutes[name]) {
                        window.location.href = muscleRoutes[name];
                    }
                });
            });


            // ===== SCROLL REVEAL =====
            var revealEls = document.querySelectorAll('.reveal, .reveal-up');

            function checkReveal() {
                var vh = window.innerHeight;
                revealEls.forEach(function (el) {
                    if (el.getBoundingClientRect().top < vh - 80) {
                        el.classList.add('revealed');
                    }
                });
            }

            checkReveal();
            window.addEventListener('scroll', checkReveal, { passive: true });


            // ===== CHART BAR ENTRANCE =====
            var chartSection = document.getElementById('weekly-progress');
            if (chartSection) {
                var chartObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            var bars = entry.target.querySelectorAll('.chart-bar');
                            bars.forEach(function (bar, i) {
                                var targetH = bar.style.height;
                                bar.style.height = '0%';
                                setTimeout(function () {
                                    bar.style.transition = 'height 0.55s ease';
                                    bar.style.height = targetH;
                                }, i * 90);
                            });
                            chartObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.25 });
                chartObserver.observe(chartSection);
            }


            // ===== STAT CARD STAGGER =====
            var statsSection = document.getElementById('quick-stats');
            if (statsSection) {
                var statObserver = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.querySelectorAll('.stat-card').forEach(function (card, i) {
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(16px)';
                                setTimeout(function () {
                                    card.style.transition = 'opacity 0.45s ease, transform 0.45s ease';
                                    card.style.opacity = '1';
                                    card.style.transform = 'translateY(0)';
                                }, i * 100);
                            });
                            statObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });
                statObserver.observe(statsSection);
            }


            // ===== SMOOTH SCROLL FOR ANCHOR LINKS =====
            document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
                anchor.addEventListener('click', function (e) {
                    var target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

        });
    </script>
}
