@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-hero {
        text-align: center;
        padding: 80px 20px 40px;
        position: relative;
    }

    .privacy-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(230, 57, 70, 0.08) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .privacy-hero h1 {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 16px;
        position: relative;
        z-index: 1;
    }

    .privacy-hero h1 .text-gradient {
        background: linear-gradient(135deg, var(--accent, #e63946), var(--accent-secondary, #ff6b35));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .privacy-hero .subtitle {
        font-size: 1.15rem;
        color: #8a8a9a;
        max-width: 560px;
        margin: 0 auto 12px;
        line-height: 1.7;
        position: relative;
        z-index: 1;
    }

    .privacy-hero .last-updated {
        font-size: 0.85rem;
        color: #55556a;
        position: relative;
        z-index: 1;
    }

    .privacy-container {
        max-width: 860px;
        margin: 0 auto;
        padding: 20px 20px 80px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .privacy-card {
        background: var(--bg-card, #16161f);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        padding: 36px;
        transition: border-color 0.3s ease, transform 0.3s ease;
    }

    .privacy-card:hover {
        border-color: rgba(230, 57, 70, 0.15);
        transform: translateY(-2px);
    }

    .privacy-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
    }

    .privacy-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(230, 57, 70, 0.12), rgba(255, 107, 53, 0.08));
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .privacy-card-icon i {
        font-size: 1.2rem;
        background: linear-gradient(135deg, var(--accent, #e63946), var(--accent-secondary, #ff6b35));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .privacy-card-header h2 {
        font-size: 1.35rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .privacy-card p {
        color: #9a9aaf;
        font-size: 0.95rem;
        line-height: 1.75;
        margin: 0 0 14px;
    }

    .privacy-card p:last-child {
        margin-bottom: 0;
    }

    .privacy-card ul {
        list-style: none;
        padding: 0;
        margin: 0 0 14px;
    }

    .privacy-card ul:last-child {
        margin-bottom: 0;
    }

    .privacy-card ul li {
        position: relative;
        padding-left: 24px;
        color: #9a9aaf;
        font-size: 0.95rem;
        line-height: 1.75;
        margin-bottom: 8px;
    }

    .privacy-card ul li:last-child {
        margin-bottom: 0;
    }

    .privacy-card ul li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 10px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent, #e63946), var(--accent-secondary, #ff6b35));
        opacity: 0.7;
    }

    .privacy-card .highlight {
        color: #cdcde0;
        font-weight: 500;
    }

    .privacy-card .contact-line {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a9aaf;
        font-size: 0.95rem;
        margin-bottom: 8px;
    }

    .privacy-card .contact-line i {
        color: var(--accent, #e63946);
        font-size: 0.85rem;
        width: 16px;
        text-align: center;
    }

    .privacy-card .contact-email {
        color: var(--accent, #e63946);
        font-weight: 500;
    }

    .privacy-divider {
        width: 100%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(230, 57, 70, 0.15), transparent);
        margin: 16px 0;
    }

    .privacy-footer {
        text-align: center;
        padding: 20px 0 40px;
    }

    .privacy-footer .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #cdcde0;
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        background: transparent;
    }

    .privacy-footer .btn-ghost:hover {
        border-color: var(--accent, #e63946);
        color: #ffffff;
        background: rgba(230, 57, 70, 0.06);
    }

    @@media (max-width: 640px) {
        .privacy-hero h1 {
            font-size: 2.2rem;
        }

        .privacy-card {
            padding: 24px;
        }

        .privacy-container {
            padding: 10px 16px 60px;
        }
    }
</style>

<div class="privacy-hero">
    <h1>
        <span class="text-gradient">Privacy</span> Policy
    </h1>
    <p class="subtitle">
        Your data security is our priority. Learn how MaxFitness protects your information.
    </p>
    <p class="last-updated">Last updated: February 2026</p>
</div>

<div class="privacy-container">

    <!-- Data Collection -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-database"></i>
            </div>
            <h2>Data Collection</h2>
        </div>
        <p>
            MaxFitness collects information to provide you with a personalized fitness experience.
            We believe in transparency about the data we gather and how it is obtained.
        </p>
        <p class="highlight">What we collect:</p>
        <ul>
            <li>Workout logs and exercise history</li>
            <li>Body measurements and progress data</li>
            <li>Exercise preferences and fitness goals</li>
            <li>Account information (name, email, profile details)</li>
        </ul>
        <div class="privacy-divider"></div>
        <p>
            All data is collected <span class="highlight">directly from your input</span> within the app
            and through your general app usage patterns. We do not collect data from external sources
            or third-party providers.
        </p>
    </div>

    <!-- Data Usage -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <h2>Data Usage</h2>
        </div>
        <p>
            Your data is used solely to enhance your fitness journey. Here is how we put your information to work:
        </p>
        <ul>
            <li>Personalize workout recommendations based on your goals and history</li>
            <li>Track your fitness progress and generate meaningful insights</li>
            <li>Improve app performance, features, and overall user experience</li>
        </ul>
        <p>
            We never use your personal fitness data for advertising purposes or sell it to
            third parties. Your progress is yours alone.
        </p>
    </div>

    <!-- Data Protection -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h2>Data Protection</h2>
        </div>
        <p>
            We take the security of your personal data seriously. Multiple layers of protection
            safeguard your information at every stage.
        </p>
        <ul>
            <li>End-to-end encryption for all personal data in transit and at rest</li>
            <li>Secure cloud storage infrastructure with regular security audits</li>
            <li>No sharing of personal data with third parties without your explicit consent</li>
            <li>Strict internal access controls and employee data handling policies</li>
        </ul>
    </div>

    <!-- Your Rights -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-user-lock"></i>
            </div>
            <h2>Your Rights</h2>
        </div>
        <p>
            You are in full control of your data. As a MaxFitness user, you have the following rights:
        </p>
        <ul>
            <li><span class="highlight">Access</span> your personal data at any time through your account settings</li>
            <li><span class="highlight">Request deletion</span> of your account and all associated data</li>
            <li><span class="highlight">Export</span> your complete fitness data in a portable format</li>
            <li><span class="highlight">Opt out</span> of optional analytics and usage tracking</li>
        </ul>
        <p>
            To exercise any of these rights, visit your account settings or reach out to our
            support team. We will process your request within 30 days.
        </p>
    </div>

    <!-- Cookies & Tracking -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-cookie-bite"></i>
            </div>
            <h2>Cookies &amp; Tracking</h2>
        </div>
        <p>
            MaxFitness uses a minimal number of cookies to ensure the app functions correctly.
        </p>
        <ul>
            <li><span class="highlight">Essential cookies</span> for core app functionality, authentication, and session management</li>
            <li><span class="highlight">Optional analytics cookies</span> to help us understand usage patterns (can be disabled in settings)</li>
            <li><span class="highlight">No advertising trackers</span> are used anywhere in the application</li>
        </ul>
        <p>
            You can manage your cookie preferences at any time through your browser settings
            or the in-app privacy controls.
        </p>
    </div>

    <!-- Contact -->
    <div class="privacy-card card-dark reveal reveal-up">
        <div class="privacy-card-header">
            <div class="privacy-card-icon">
                <i class="fa-solid fa-envelope"></i>
            </div>
            <h2>Contact Us</h2>
        </div>
        <p>
            If you have any questions, concerns, or requests regarding this privacy policy
            or how your data is handled, we are here to help.
        </p>
        <div class="contact-line">
            <i class="fa-solid fa-at"></i>
            <span>Privacy inquiries: <span class="contact-email">support@maxfitness.com</span></span>
        </div>
        <div class="contact-line">
            <i class="fa-solid fa-user-shield"></i>
            <span>Data Protection Officer: <span class="contact-email">dpo@maxfitness.com</span></span>
        </div>
        <div class="privacy-divider"></div>
        <p>
            We aim to respond to all privacy-related inquiries within 48 hours.
        </p>
    </div>

    <div class="privacy-footer">
        <a asp-controller="Home" asp-action="Index" class="btn-ghost">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

</div>
