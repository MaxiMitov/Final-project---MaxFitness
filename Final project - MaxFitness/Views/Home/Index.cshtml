<!-- ============================================================
     QUICK STATS ROW
     ============================================================ -->
<section class="section-padding reveal reveal-up" id="quick-stats">
    <div class="container">
        <div class="stat-grid">
            <!-- Card 1: Weekly Workouts -->
            <div class="stat-card">
                <div class="stat-card-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">Weekly Workouts</span>
                    <span class="stat-card-value">@stats.WeeklyWorkouts<span class="stat-card-unit">/@stats.WeeklyGoal</span></span>
                    <div class="stat-progress-bar">
                        <div class="stat-progress-fill" style="width: @(stats.WeeklyProgressPercent)%;"></div>
                    </div>
                    @{ var remaining = Math.Max(0, stats.WeeklyGoal - stats.WeeklyWorkouts); }
                    <span class="stat-card-detail">@(remaining == 0 ? "Goal reached!" : $"{remaining} workout{(remaining == 1 ? "" : "s")} remaining")</span>
                </div>
            </div>

            <!-- Card 2: Active Streak -->
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon--fire">
                    <i class="fa-solid fa-fire"></i>
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">Active Streak</span>
                    <span class="stat-card-value">@stats.Streak <span class="stat-card-unit">@(stats.Streak == 1 ? "Day" : "Days")</span></span>
                    @if (stats.Streak >= 7)
                    {
                        <span class="stat-badge stat-badge--gold">
                            <i class="fa-solid fa-trophy"></i> On Fire!
                        </span>
                    }
                </div>
            </div>

            <!-- Card 3: Calories Burned -->
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon--lightning">
                    <i class="fa-solid fa-bolt-lightning"></i>
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">Calories Burned</span>
                    <span class="stat-card-value">@stats.CaloriesThisWeek.ToString("N0")</span>
                    <span class="stat-card-detail">This Week</span>
                </div>
            </div>

            <!-- Card 4: Avg Intensity -->
            <div class="stat-card">
                <div class="stat-card-icon stat-card-icon--chart">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <div class="stat-card-body">
                    <span class="stat-card-label">Avg Intensity</span>
                    <span class="stat-card-value">@stats.AvgIntensity<span class="stat-card-unit">%</span></span>
                    <div class="intensity-ring-container">
                        <svg class="intensity-ring" viewBox="0 0 60 60">
                            <circle cx="30" cy="30" r="26" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="5" />
                            <circle cx="30" cy="30" r="26" fill="none" stroke="url(#intensityGrad)" stroke-width="5"
                                    stroke-dasharray="@circumference.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" stroke-dashoffset="@intensityOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" stroke-linecap="round"
                                    transform="rotate(-90 30 30)" />
                            <defs>
                                <linearGradient id="intensityGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#e63946" />
                                    <stop offset="100%" stop-color="#ff6b35" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


