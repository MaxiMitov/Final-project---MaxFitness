@{
    // Use a null-coalescing check to prevent the "null reference" crash
    var muscleName = ViewBag.MuscleName ?? "Muscle";
    ViewData["Title"] = muscleName + " Analytics";
}

<style>
    .muscle-detail-card {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 2rem;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .accent-text {
        color: var(--accent-color);
    }

    .exercise-row {
        background: rgba(255,255,255,0.03);
        border-radius: 12px;
        transition: 0.3s;
    }

        .exercise-row:hover {
            background: rgba(0, 242, 255, 0.1);
        }
</style>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bold">@muscleName <span class="accent-text">Performance</span></h1>
                <p class="text-muted">In-depth analysis of your @muscleName.ToLower() development.</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="muscle-detail-card mb-4">
                <h5 class="text-muted small text-uppercase">Current PR</h5>
                <h2 class="display-4 fw-bold accent-text">@(ViewBag.Muscle?.CurrentPR ?? "0 lbs")</h2>
                <div class="progress-bar-container mt-3" style="height:4px; background: #333;">
                    <div class="progress-fill" style="width: @(ViewBag.Muscle?.ProgressPercentage ?? 0)%;"></div>
                </div>
            </div>

            <div class="muscle-detail-card">
                <h5 class="text-muted small text-uppercase mb-3">Target Info</h5>
                <h3 class="fw-bold text-white">Focus: Strength</h3>
                <p class="small text-muted">Stat tracking is active for @muscleName.</p>
                <button class="btn btn-sm btn-outline-info w-100 mt-2">View History (Async)</button>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="muscle-detail-card h-100">
                <h4 class="mb-4">Recommended Routine</h4>
                @if (ViewBag.Exercises != null)
                {
                    @foreach (var exercise in (List<ExerciseDetail>)ViewBag.Exercises)
                    {
                        <div class="exercise-row p-3 mb-2 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold d-block">@exercise.Name</span>
                                <span class="small text-muted">@exercise.Difficulty</span>
                            </div>
                            <div class="text-end">
                                <span class="accent-text d-block fw-bold">@exercise.TargetReps</span>
                                <span class="small text-muted">@exercise.Intensity</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>