<!-- ============================================================
     PAGE-SPECIFIC STYLES
     ============================================================ -->
<style>
    /* ==================== HERO ==================== */
    .hero-section {
        position: relative;
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow: hidden;
        padding: 2rem 0 0;
    }

    .hero-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        flex: 1;
    }

    .hero-content {
        flex: 1;
        max-width: 640px;
        z-index: 2;
    }

    .hero-heading {
        font-size: clamp(2.8rem, 6vw, 5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .hero-line {
        display: block;
    }

    .hero-subtitle {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 2rem;
        max-width: 480px;
    }

    .hero-cta-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .hero-visual {
        flex: 0 0 auto;
        width: 380px;
        height: 380px;
        position: relative;
        z-index: 1;
    }

    .hero-hud-svg {
        width: 100%;
        height: 100%;
        opacity: 0.6;
    }

    @@keyframes hudRotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .hud-ring-rotate {
        transform-origin: 250px 250px;
        animation: hudRotate 30s linear infinite;
    }

    @@keyframes hudPulse {
        0%, 100% { r: 4; opacity: 0.3; }
        50% { r: 7; opacity: 0.8; }
    }

    .hud-pulse {
        animation: hudPulse 2s ease-in-out infinite;
    }

    /* Grid overlay */
    .hero-grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(230,57,70,0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(230,57,70,0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
        z-index: 0;
    }

    /* Particles */
    .hero-particles {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .particle {
        position: absolute;
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: rgba(230, 57, 70, 0.4);
        animation: particleFloat 8s ease-in-out infinite;
    }

    .particle-1 { top: 15%; left: 10%; animation-delay: 0s; }
    .particle-2 { top: 25%; left: 80%; animation-delay: 1s; background: rgba(255,107,53,0.4); }
    .particle-3 { top: 60%; left: 20%; animation-delay: 2s; }
    .particle-4 { top: 70%; left: 70%; animation-delay: 3s; background: rgba(255,209,102,0.3); }
    .particle-5 { top: 40%; left: 50%; animation-delay: 4s; background: rgba(255,107,53,0.3); }
    .particle-6 { top: 80%; left: 30%; animation-delay: 5s; }
    .particle-7 { top: 10%; left: 60%; animation-delay: 6s; background: rgba(255,209,102,0.3); }
    .particle-8 { top: 50%; left: 90%; animation-delay: 7s; }

    @@keyframes particleFloat {
        0%, 100% { transform: translateY(0) translateX(0); opacity: 0.3; }
        25% { transform: translateY(-20px) translateX(10px); opacity: 0.7; }
        50% { transform: translateY(-10px) translateX(-5px); opacity: 0.5; }
        75% { transform: translateY(-25px) translateX(15px); opacity: 0.6; }
    }

    /* Stats ticker */
    .hero-stats-ticker {
        border-top: 1px solid rgba(255,255,255,0.06);
        padding: 1.25rem 0;
        z-index: 2;
    }

    .ticker-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5rem;
        flex-wrap: wrap;
    }

    .ticker-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .ticker-value {
        font-size: 1.2rem;
        font-weight: 800;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .ticker-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .ticker-divider {
        width: 1px;
        height: 24px;
        background: rgba(255,255,255,0.1);
    }


    /* ==================== SECTION UTILS ==================== */
    .section-padding {
        padding: 5rem 0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-title {
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.5rem;
    }

    .section-subtitle {
        color: var(--text-secondary);
        font-size: 1rem;
    }


    /* ==================== STAT CARDS ==================== */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-primary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .stat-card:hover {
        border-color: rgba(230,57,70,0.2);
        transform: translateY(-2px);
    }

    .stat-card:hover::before {
        opacity: 1;
    }

    .stat-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: rgba(230,57,70,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: var(--accent);
        flex-shrink: 0;
    }

    .stat-card-icon--fire {
        background: rgba(255,107,53,0.1);
        color: var(--accent-secondary);
    }

    .stat-card-icon--lightning {
        background: rgba(255,209,102,0.1);
        color: var(--accent-tertiary);
    }

    .stat-card-icon--chart {
        background: rgba(230,57,70,0.1);
        color: var(--accent);
    }

    .stat-card-body {
        flex: 1;
        min-width: 0;
    }

    .stat-card-label {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin-bottom: 0.25rem;
    }

    .stat-card-value {
        display: block;
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1.2;
        color: var(--text-primary);
    }

    .stat-card-unit {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .stat-card-detail {
        display: block;
        font-size: 0.78rem;
        color: var(--text-secondary);
        margin-top: 0.25rem;
    }

    .stat-progress-bar {
        height: 4px;
        background: rgba(255,255,255,0.06);
        border-radius: 4px;
        margin-top: 0.6rem;
        overflow: hidden;
    }

    .stat-progress-fill {
        height: 100%;
        background: var(--gradient-primary);
        border-radius: 4px;
        transition: width 1s ease;
    }

    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        margin-top: 0.5rem;
    }

    .stat-badge--gold {
        background: rgba(255,209,102,0.15);
        color: var(--accent-tertiary);
        border: 1px solid rgba(255,209,102,0.3);
    }

    .intensity-ring-container {
        margin-top: 0.4rem;
    }

    .intensity-ring {
        width: 48px;
        height: 48px;
    }


    /* ==================== BODY MAP ==================== */
    .body-map-section {
        position: relative;
    }

    .body-map-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
    }

    .body-map-container {
        position: relative;
        display: flex;
        justify-content: center;
        padding: 2rem;
    }

    .body-map-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 300px;
        height: 400px;
        background: radial-gradient(ellipse, rgba(230,57,70,0.06) 0%, transparent 70%);
        pointer-events: none;
    }

    .body-map-svg {
        width: 100%;
        max-width: 300px;
        height: auto;
        position: relative;
        z-index: 1;
    }

    .muscle-group {
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .muscle-group:hover {
        filter: url(#activeGlow);
    }

    .muscle-group[data-status="strong"]:hover {
        fill: rgba(34,197,94,0.45);
        stroke: rgba(34,197,94,0.8);
        stroke-width: 2;
    }

    .muscle-group[data-status="moderate"]:hover {
        fill: rgba(255,107,53,0.45);
        stroke: rgba(255,107,53,0.8);
        stroke-width: 2;
    }

    .muscle-group[data-status="needs-work"]:hover {
        fill: rgba(230,57,70,0.45);
        stroke: rgba(230,57,70,0.8);
        stroke-width: 2;
    }

    /* Scan line animation */
    @@keyframes bodyScan {
        0% { transform: translateY(0); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(520px); opacity: 0; }
    }

    .body-scan-line {
        animation: bodyScan 4s ease-in-out infinite;
    }

    /* Body map labels */
    .body-map-label {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        pointer-events: none;
        z-index: 2;
    }

    .body-map-label-text {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .body-map-label-line {
        display: block;
        width: 20px;
        height: 1px;
        background: rgba(255,255,255,0.15);
    }

    /* Info panel */
    .body-map-info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .body-map-info-title {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .legend-items {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .legend-dot--strong { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.4); }
    .legend-dot--moderate { background: #ff6b35; box-shadow: 0 0 8px rgba(255,107,53,0.4); }
    .legend-dot--needs-work { background: #e63946; box-shadow: 0 0 8px rgba(230,57,70,0.4); }

    .legend-text {
        font-size: 0.9rem;
        color: var(--text-primary);
    }

    .legend-desc {
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    /* Detail panel */
    .muscle-detail-panel {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 1.5rem;
        min-height: 200px;
        transition: all 0.3s ease;
    }

    .muscle-detail-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 160px;
        color: var(--text-secondary);
        gap: 0.75rem;
    }

    .muscle-detail-empty i {
        font-size: 2rem;
        opacity: 0.4;
    }

    .muscle-detail-empty p {
        font-size: 0.85rem;
        text-align: center;
    }

    .muscle-detail-name {
        font-size: 1.3rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .muscle-detail-status {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        margin-bottom: 1rem;
    }

    .muscle-detail-status.status--strong {
        background: rgba(34,197,94,0.15);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.3);
    }

    .muscle-detail-status.status--moderate {
        background: rgba(255,107,53,0.15);
        color: #ff6b35;
        border: 1px solid rgba(255,107,53,0.3);
    }

    .muscle-detail-status.status--needs-work {
        background: rgba(230,57,70,0.15);
        color: #e63946;
        border: 1px solid rgba(230,57,70,0.3);
    }

    .muscle-detail-stats {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

    .muscle-detail-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.88rem;
        color: var(--text-secondary);
    }

    .muscle-detail-row i {
        width: 18px;
        text-align: center;
        color: var(--accent);
    }

    .muscle-detail-row strong {
        color: var(--text-primary);
        margin-left: auto;
    }

    .muscle-detail-btn {
        display: inline-flex;
        width: 100%;
        justify-content: center;
    }

    /* Summary */
    .body-map-summary {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .summary-stat-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .summary-stat-row:last-of-type {
        border-bottom: none;
    }

    .summary-label {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .summary-value {
        font-weight: 700;
        font-size: 0.95rem;
    }

    .summary-value--strong { color: #22c55e; }
    .summary-value--moderate { color: #ff6b35; }
    .summary-value--needs-work { color: #e63946; }

    .summary-progress-bar {
        display: flex;
        height: 6px;
        border-radius: 6px;
        overflow: hidden;
        margin-top: 1rem;
        gap: 2px;
    }

    .summary-progress-segment {
        height: 100%;
        border-radius: 3px;
        transition: width 1s ease;
    }

    .summary-progress--strong { background: #22c55e; }
    .summary-progress--moderate { background: #ff6b35; }
    .summary-progress--needs-work { background: #e63946; }

    .body-map-hint {
        text-align: center;
        color: var(--text-secondary);
        font-size: 0.85rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255,255,255,0.04);
    }

    .body-map-hint i {
        color: var(--accent);
        margin-right: 0.3rem;
    }


    /* ==================== ACTIVITY LIST ==================== */
    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .activity-card {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 1.25rem 1.5rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .activity-card:hover {
        border-color: rgba(230,57,70,0.15);
        transform: translateX(4px);
    }

    .activity-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .activity-icon--push { background: rgba(230,57,70,0.12); color: #e63946; }
    .activity-icon--legs { background: rgba(255,107,53,0.12); color: #ff6b35; }
    .activity-icon--pull { background: rgba(34,197,94,0.12); color: #22c55e; }
    .activity-icon--arms { background: rgba(255,209,102,0.12); color: #ffd166; }
    .activity-icon--hiit { background: rgba(230,57,70,0.12); color: #e63946; }

    .activity-info {
        flex: 1;
        min-width: 0;
    }

    .activity-name {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.15rem;
    }

    .activity-date {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .activity-meta {
        display: flex;
        gap: 1.25rem;
    }

    .activity-meta-item {
        font-size: 0.82rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
    }

    .activity-meta-item i {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
    }

    .activity-intensity {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .activity-intensity--high {
        background: rgba(255,107,53,0.12);
        color: #ff6b35;
        border: 1px solid rgba(255,107,53,0.25);
    }

    .activity-intensity--extreme {
        background: rgba(230,57,70,0.12);
        color: #e63946;
        border: 1px solid rgba(230,57,70,0.25);
    }

    .activity-intensity--medium {
        background: rgba(255,209,102,0.12);
        color: #ffd166;
        border: 1px solid rgba(255,209,102,0.25);
    }


    /* ==================== WEEKLY CHART ==================== */
    .weekly-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    .weekly-chart {
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .chart-area {
        display: flex;
        gap: 1rem;
        align-items: flex-end;
        height: 280px;
    }

    .chart-y-axis {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        padding-bottom: 28px;
    }

    .chart-y-axis span {
        font-size: 0.7rem;
        color: var(--text-secondary);
        text-align: right;
        min-width: 28px;
    }

    .chart-bars {
        display: flex;
        gap: 0.75rem;
        flex: 1;
        align-items: flex-end;
        height: 100%;
    }

    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .chart-bar {
        width: 100%;
        max-width: 48px;
        border-radius: 6px 6px 2px 2px;
        position: relative;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .chart-bar--active {
        background: var(--gradient-primary);
        box-shadow: 0 2px 12px rgba(230,57,70,0.2);
    }

    .chart-bar--active:hover {
        box-shadow: 0 4px 20px rgba(230,57,70,0.35);
        filter: brightness(1.15);
    }

    .chart-bar--best {
        box-shadow: 0 2px 16px rgba(255,107,53,0.3);
    }

    .chart-bar--rest {
        background: rgba(255,255,255,0.04);
    }

    .chart-bar-tooltip {
        position: absolute;
        top: -28px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--text-primary);
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
    }

    .chart-bar:hover .chart-bar-tooltip {
        opacity: 1;
    }

    .chart-day {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .chart-day--rest {
        opacity: 0.4;
    }

    /* Weekly side stats */
    .weekly-stats {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .weekly-stat-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
        transition: all 0.3s ease;
    }

    .weekly-stat-card:hover {
        border-color: rgba(230,57,70,0.15);
    }

    .weekly-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: rgba(230,57,70,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        font-size: 1rem;
        flex-shrink: 0;
    }

    .weekly-stat-info {
        flex: 1;
    }

    .weekly-stat-value {
        display: block;
        font-size: 1.3rem;
        font-weight: 800;
    }

    .weekly-stat-unit {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .weekly-stat-label {
        font-size: 0.75rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }


    /* ==================== ACHIEVEMENTS ==================== */
    .achievements-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .achievement-card {
        position: relative;
        border-radius: 12px;
        padding: 1.75rem 1.5rem;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.05);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .achievement-card:hover {
        transform: translateY(-3px);
    }

    .achievement--unlocked.achievement--gold {
        border-color: rgba(255,209,102,0.3);
    }

    .achievement--gold:hover {
        box-shadow: 0 0 30px rgba(255,209,102,0.15);
    }

    .achievement-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center, rgba(255,209,102,0.06) 0%, transparent 70%);
        pointer-events: none;
    }

    .achievement--locked {
        opacity: 0.5;
    }

    .achievement-lock-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        pointer-events: none;
    }

    .achievement-lock-overlay i {
        font-size: 2.5rem;
        color: rgba(255,255,255,0.08);
    }

    .achievement-icon-area {
        margin-bottom: 1rem;
        position: relative;
        z-index: 1;
    }

    .achievement-icon-ring {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .achievement-icon-ring--gold {
        background: rgba(255,209,102,0.12);
        border: 2px solid rgba(255,209,102,0.4);
        color: #ffd166;
        box-shadow: 0 0 20px rgba(255,209,102,0.15);
    }

    .achievement-icon-ring--accent {
        background: rgba(230,57,70,0.1);
        border: 2px solid rgba(230,57,70,0.3);
        color: var(--accent);
    }

    .achievement-icon-ring--locked {
        background: rgba(255,255,255,0.04);
        border: 2px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.2);
    }

    .achievement-title {
        font-size: 1.05rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        position: relative;
        z-index: 1;
    }

    .achievement-desc {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
        position: relative;
        z-index: 1;
    }

    .achievement-status {
        position: relative;
        z-index: 1;
    }

    .achievement-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .achievement-badge--unlocked {
        background: rgba(34,197,94,0.12);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.25);
    }

    .achievement-badge--progress {
        background: rgba(255,107,53,0.12);
        color: #ff6b35;
        border: 1px solid rgba(255,107,53,0.25);
    }

    .achievement-badge--locked {
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.3);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .achievement-progress-bar {
        height: 5px;
        background: rgba(255,255,255,0.06);
        border-radius: 5px;
        margin-top: 1rem;
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .achievement-progress-fill {
        height: 100%;
        border-radius: 5px;
        background: var(--gradient-primary);
        transition: width 1.5s ease;
    }

    .achievement-progress--complete .achievement-progress-fill {
        background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .achievement-progress--locked .achievement-progress-fill {
        background: rgba(255,255,255,0.06);
    }

    .achievement-progress-text {
        font-size: 0.72rem;
        color: var(--text-secondary);
        margin-top: 0.4rem;
        display: block;
        position: relative;
        z-index: 1;
    }


    /* ==================== FOOTER CTA ==================== */
    .footer-cta-section {
        position: relative;
        padding: 6rem 0;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(180deg, var(--bg-primary) 0%, rgba(22,22,31,0.8) 100%);
    }

    .footer-cta-container {
        position: relative;
        z-index: 2;
    }

    .footer-cta-heading {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 900;
        margin-bottom: 0.75rem;
    }

    .footer-cta-subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .footer-cta-orb {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(80px);
    }

    .footer-cta-orb--1 {
        width: 400px;
        height: 400px;
        background: rgba(230,57,70,0.08);
        top: -100px;
        right: -100px;
    }

    .footer-cta-orb--2 {
        width: 300px;
        height: 300px;
        background: rgba(255,107,53,0.06);
        bottom: -80px;
        left: -80px;
    }

    .footer-cta-orb--3 {
        width: 200px;
        height: 200px;
        background: rgba(255,209,102,0.04);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }


    /* ==================== BUTTONS ==================== */
    .btn-accent {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--gradient-primary);
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-accent:hover {
        filter: brightness(1.1);
        box-shadow: 0 4px 20px rgba(230,57,70,0.3);
        transform: translateY(-1px);
        color: #fff;
        text-decoration: none;
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: transparent;
        color: var(--text-primary);
        font-weight: 700;
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-ghost:hover {
        border-color: rgba(230,57,70,0.4);
        background: rgba(230,57,70,0.08);
        color: var(--text-primary);
        text-decoration: none;
    }

    .btn-lg {
        padding: 0.9rem 2rem;
        font-size: 1rem;
    }

    .btn-xl {
        padding: 1.1rem 2.5rem;
        font-size: 1.1rem;
        border-radius: 10px;
    }

    .btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
    }


    /* ==================== SCROLL REVEAL ==================== */
    .reveal,
    .reveal-up {
        opacity: 0;
        transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal {
        transform: translateY(0);
    }

    .reveal-up {
        transform: translateY(40px);
    }

    .reveal.revealed,
    .reveal-up.revealed {
        opacity: 1;
        transform: translateY(0);
    }


    /* ==================== NEEDS-WORK PULSE ==================== */
    @@keyframes musclePulseAnim {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.55; }
    }

    .muscle-group[data-status="needs-work"] {
        animation: musclePulseAnim 2.5s ease-in-out infinite;
    }


    /* ==================== RESPONSIVE ==================== */
    @@media (max-width: 1024px) {
        .stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .body-map-layout {
            grid-template-columns: 1fr;
        }

        .weekly-layout {
            grid-template-columns: 1fr;
        }

        .achievements-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-visual {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .hero-heading {
            font-size: 2.4rem;
        }

        .hero-cta-group {
            flex-direction: column;
