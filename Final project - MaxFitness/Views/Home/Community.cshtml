}

.cm-challenge-card:hover {
    border-color: color-mix(in srgb, var(--ch-color) 40%, transparent);
    background: color-mix(in srgb, var(--ch-color) 6%, transparent);
}

.cm-challenge-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--ch-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--ch-color) 35%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--ch-color);
    flex-shrink: 0;
}

.cm-challenge-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
}

.cm-challenge-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cm-challenge-count {
    font-size: 0.68rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.cm-join-btn {
    background: none;
    border: 1px solid color-mix(in srgb, var(--ch-color) 50%, transparent);
    color: var(--ch-color);
    font-size: 0.72rem;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    letter-spacing: 0.03em;
}

.cm-join-btn:hover,
.cm-join-btn.joined {
    background: color-mix(in srgb, var(--ch-color) 18%, transparent);
}

.cm-join-btn.joined::before {
    content: "✓ ";
}

/* ── Top Contributors ─────────────────────────────────────────── */
.cm-contributors {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.cm-contrib-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

.cm-contrib-rank {
    font-size: 0.82rem;
    font-weight: 900;
    min-width: 22px;
    text-align: right;
}

.cm-contrib-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
}

.cm-contrib-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cm-contrib-count {
    font-size: 0.68rem;
    color: var(--text-secondary);
}

.cm-contrib-bar-wrap {
    width: 48px;
    height: 4px;
    background: rgba(255,255,255,0.07);
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
}

.cm-contrib-bar {
    height: 100%;
    border-radius: 999px;
    transition: width 0.5s ease;
}

/* ── Popular Tags Cloud ───────────────────────────────────────── */
.cm-tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
}

.cm-cloud-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.cm-cloud-tag:hover {
    color: var(--accent-secondary);
    border-color: rgba(255,107,53,0.35);
    background: rgba(255,107,53,0.07);
}

/* ── Responsive ───────────────────────────────────────────────── */
@@media (max-width: 992px) {
    .cm-layout {
        grid-template-columns: 1fr;
    }

    .cm-sidebar {
        position: static;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
}

@@media (max-width: 640px) {
    .cm-header-live { display: none; }

    .cm-sidebar {
        grid-template-columns: 1fr;
    }

    .cm-create-actions {
        gap: 0.4rem;
    }

    .cm-attach-btn {
        font-size: 0.74rem;
        padding: 0.38rem 0.65rem;
    }

    .cm-post-btn {
        padding: 0.45rem 1rem;
    }

    .cm-feed-tabs {
        overflow-x: auto;
        padding-bottom: 0.25rem;
    }

    .cm-tab-btn {
        white-space: nowrap;
    }
}

</style>

<script>
// Like toggle with count increment
function toggleLike(btn) {
    var countEl = btn.querySelector('.cm-like-count');
    var count   = parseInt(countEl.textContent, 10) || 0;

    if (btn.classList.contains('liked')) {
        btn.classList.remove('liked');
        countEl.textContent = count - 1;
    } else {
        btn.classList.add('liked');
        countEl.textContent = count + 1;
    }
}

// Bookmark toggle
function toggleBookmark(btn) {
    btn.classList.toggle('saved');
}

// Feed filter tabs
function setCmTab(btn) {
    document.querySelectorAll('.cm-tab-btn').forEach(function(b) {
        b.classList.remove('active');
    });
    btn.classList.add('active');
}

// Challenge join toggle
function toggleJoin(btn) {
    if (btn.classList.contains('joined')) {
        btn.classList.remove('joined');
        btn.textContent = 'Join';
    } else {
        btn.classList.add('joined');
        btn.textContent = '\u2713 Joined';
    }
}

// Follow toggle
document.querySelectorAll('.cm-follow-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        if (this.classList.contains('following')) {
            this.classList.remove('following');
            this.textContent = 'Follow';
        } else {
            this.classList.add('following');
            this.textContent = 'Following';
        }
    });
});
</script>
