@{
    ViewData["Title"] = "500 - Server Error";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>500 – Server Error | MaxFitness</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --bg-primary: #08080d;
            --bg-card: #16161f;
            --bg-card-hover: #1e1e2a;
            --accent: #e63946;
            --accent-dim: rgba(230, 57, 70, 0.15);
            --accent-orange: #ff6d28;
            --text-primary: #f0f0f5;
            --text-secondary: #8888a0;
            --border: rgba(255, 255, 255, 0.07);
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            background: var(--bg-primary);
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Ambient background */
        .bg-blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 0;
        }

        .blob-1 {
            width: 550px;
            height: 550px;
            background: rgba(230, 57, 70, 0.07);
            top: -180px;
            right: -180px;
        }

        .blob-2 {
            width: 450px;
            height: 450px;
            background: rgba(255, 109, 40, 0.05);
            bottom: -120px;
            left: -120px;
        }

        /* Scanline overlay */
        .scanlines {
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                rgba(0, 0, 0, 0.03) 2px,
                rgba(0, 0, 0, 0.03) 4px
            );
            pointer-events: none;
            z-index: 1;
        }

        .container {
            position: relative;
            z-index: 2;
            text-align: center;
            padding: 2rem;
            max-width: 620px;
            width: 100%;
        }

        /* Glitch 500 number */
        .error-code {
            font-size: clamp(7rem, 20vw, 12rem);
            font-weight: 900;
            line-height: 1;
            letter-spacing: -0.04em;
            color: var(--text-primary);
            position: relative;
            display: inline-block;
            animation: shake 6s ease-in-out infinite;
        }

        .error-code::before,
        .error-code::after {
            content: '500';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        .error-code::before {
            color: var(--accent);
            animation: glitch-red 5s infinite;
            clip-path: polygon(0 15%, 100% 15%, 100% 38%, 0 38%);
        }

        .error-code::after {
            color: var(--accent-orange);
            animation: glitch-orange 5s infinite;
            clip-path: polygon(0 55%, 100% 55%, 100% 72%, 0 72%);
        }

        @@keyframes shake {
            0%, 95%, 100% { transform: translate(0); }
            96% { transform: translate(-3px, 1px) rotate(-0.3deg); }
            97% { transform: translate(3px, -1px) rotate(0.3deg); }
            98% { transform: translate(-1px, 2px); }
            99% { transform: translate(1px, -2px); }
        }

        @@keyframes glitch-red {
            0%, 80%, 100% { transform: translate(0); opacity: 0; }
            82% { transform: translate(-5px, 1px); opacity: 0.9; }
            84% { transform: translate(5px, -1px); opacity: 0.7; }
            86% { transform: translate(-3px, 0); opacity: 0.85; }
            88% { transform: translate(0); opacity: 0; }
        }

        @@keyframes glitch-orange {
            0%, 83%, 100% { transform: translate(0); opacity: 0; }
            85% { transform: translate(5px, 0); opacity: 0.8; }
            87% { transform: translate(-5px, 1px); opacity: 0.6; }
            89% { transform: translate(2px, 0); opacity: 0.75; }
            91% { transform: translate(0); opacity: 0; }
        }

        /* Divider */
        .divider {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent-orange), var(--accent), transparent);
            margin: 0.5rem auto 2rem;
            border-radius: 2px;
            animation: pulse-line 2.5s ease-in-out infinite;
        }

        @@keyframes pulse-line {
            0%, 100% { opacity: 0.5; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.4); }
        }

        .error-title {
            font-size: clamp(1.4rem, 4vw, 2rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .error-message {
            font-size: 1rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 2.5rem;
            max-width: 420px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Icon badge */
        .icon-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(255, 109, 40, 0.12);
            border: 1px solid rgba(255, 109, 40, 0.25);
            margin-bottom: 1.5rem;
            animation: pulse-badge 2s ease-in-out infinite;
        }

        .icon-badge i {
            font-size: 1.4rem;
            color: var(--accent-orange);
        }

        @@keyframes pulse-badge {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 109, 40, 0); }
            50% { box-shadow: 0 0 0 8px rgba(255, 109, 40, 0.08); }
        }

        /* Buttons */
        .btn-group {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-retry {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.85rem 1.8rem;
            background: var(--bg-card);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s, transform 0.15s;
        }

        .btn-retry:hover {
            background: var(--bg-card-hover);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
            color: var(--text-primary);
            text-decoration: none;
        }

        .btn-dashboard {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.85rem 1.8rem;
            background: var(--accent);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 20px rgba(230, 57, 70, 0.35);
        }

        .btn-dashboard:hover {
            background: #c1121f;
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(230, 57, 70, 0.5);
            color: #fff;
            text-decoration: none;
        }

        .btn-dashboard:active,
        .btn-retry:active {
            transform: translateY(0);
        }

        /* Status chip */
        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.3rem 0.85rem;
            background: rgba(255, 109, 40, 0.1);
            border: 1px solid rgba(255, 109, 40, 0.2);
            border-radius: 100px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent-orange);
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-orange);
            animation: blink 1.4s ease-in-out infinite;
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.2; }
        }

        /* Brand */
        .brand {
            position: fixed;
            top: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            z-index: 10;
            text-decoration: none;
        }

        .brand span.red {
            background: linear-gradient(135deg, var(--accent), #ff6b6b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand span.white {
            color: var(--text-primary);
        }

        /* Noise texture */
        .noise {
            position: fixed;
            inset: 0;
            opacity: 0.025;
            pointer-events: none;
            z-index: 1;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
            background-repeat: repeat;
            background-size: 128px 128px;
        }
    </style>
</head>
<body>
    <div class="noise"></div>
    <div class="scanlines"></div>
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <a href="/" class="brand">
        <span class="red">Max</span><span class="white">Fitness</span>
    </a>

    <div class="container">
        <div class="icon-badge">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <div class="error-code">500</div>
        <div class="divider"></div>

        <div class="status-chip">
            <span class="status-dot"></span>
            Service Disruption
        </div>

        <h1 class="error-title">Server Error</h1>
        <p class="error-message">
            Something went wrong on our end. Please try again later.
        </p>

        <div class="btn-group">
            <a href="javascript:location.reload()" class="btn-retry">
                <i class="fa-solid fa-rotate-right"></i>
                Try Again
            </a>
            <a href="/" class="btn-dashboard">
                <i class="fa-solid fa-house"></i>
                Back to Dashboard
            </a>
        </div>
    </div>
</body>
</html>
