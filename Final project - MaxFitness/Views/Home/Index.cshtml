    .footer-cta-heading {
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 0.4rem;
        line-height: 1.15;
    }

    .footer-cta-sub {
        font-size: 0.92rem;
