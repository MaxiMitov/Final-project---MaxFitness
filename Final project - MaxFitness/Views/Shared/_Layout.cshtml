@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFitness</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
</head>
<body>
    <header style="position: fixed; top: 0; left: 0; right: 0; z-index: 9999;">
        <nav class="navbar-maxfit" id="mainNavbar">
            <div class="container d-flex justify-content-between align-items-center">
                <!-- Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="logo-max">MAX</span><span class="logo-fitness">FITNESS</span>
                </a>

                <!-- Center nav links -->
                <div class="d-flex align-items-center gap-1">
                    <a class="nav-link-maxfit" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house"></i> <span>Dashboard</span>
                    </a>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a class="nav-link-maxfit" asp-area="" asp-controller="Workout" asp-action="Index">
                            <i class="fa-solid fa-book-open"></i> <span>My Log</span>
                        </a>
                    }
                    <a class="nav-link-maxfit" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-chart-line"></i> <span>Overview</span>
                    </a>
                </div>

                <!-- Right side -->
                <div class="nav-right">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a class="nav-btn-workout" asp-area="" asp-controller="Workout" asp-action="Index">
                            <i class="fa-solid fa-plus"></i> New Workout
                        </a>
                        <a class="nav-user-link" asp-area="" asp-controller="Home" asp-action="Settings" title="Profile">
                            <div class="nav-avatar">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="nav-username">@User.Identity?.Name</span>
                        </a>
                        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="nav-logout-btn" title="Logout">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link-maxfit" asp-area="Identity" asp-page="/Account/Login">
                            <i class="fa-solid fa-right-to-bracket"></i> <span>Login</span>
                        </a>
                        <a class="nav-btn-signup" asp-area="Identity" asp-page="/Account/Register">
                            <i class="fa-solid fa-user-plus"></i> Sign Up
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content" style="margin-top: 72px; min-height: 80vh; position: relative; z-index: 1; isolation: isolate;">
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-maxfit" style="position: relative; z-index: 1;">
        <div class="footer-gradient-line"></div>
        <div class="container">
            <div class="row gy-4 py-5">
                <div class="col-lg-3 col-md-6">
                    <div class="footer-brand">
                        <a class="d-inline-block mb-3 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                            <span class="logo-max">MAX</span><span class="logo-fitness">FITNESS</span>
                        </a>
                        <p class="footer-tagline">Push your limits. Track your gains.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-chevron-right me-1"></i> Dashboard</a></li>
                        <li><a asp-area="" asp-controller="Workout" asp-action="Index"><i class="fa-solid fa-chevron-right me-1"></i> Workouts</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-chevron-right me-1"></i> Progress</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-chevron-right me-1"></i> Nutrition</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Resources</h6>
                    <ul class="footer-links">
                        <li><a href="#"><i class="fa-solid fa-chevron-right me-1"></i> Blog</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right me-1"></i> FAQ</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right me-1"></i> Support</a></li>
                        <li><a href="#"><i class="fa-solid fa-chevron-right me-1"></i> API</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Connect</h6>
                    <div class="footer-social">
                        <a href="#" class="social-icon" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-icon" aria-label="X (Twitter)"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#" class="social-icon" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#" class="social-icon" aria-label="Discord"><i class="fa-brands fa-discord"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0">&copy; 2026 MaxFitness. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <p class="mb-0 footer-built-with">Built with discipline.</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const navbar = document.getElementById('mainNavbar');
            if (!navbar) return;
            function handleScroll() {
                if (window.scrollY > 50) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            }
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
