@{
    ViewData["Title"] = "Dashboard";
    var stats = ViewBag.Stats as Final_project___MaxFitness.Models.DashboardStats ?? new Final_project___MaxFitness.Models.DashboardStats();
    var muscleStatuses = ViewBag.MuscleStatuses as List<Final_project___MaxFitness.Models.MuscleStatus> ?? new List<Final_project___MaxFitness.Models.MuscleStatus>();
    var recentWorkouts = ViewBag.RecentWorkouts as List<Final_project___MaxFitness.Models.RecentWorkout> ?? new List<Final_project___MaxFitness.Models.RecentWorkout>();

    // Build muscle lookup dictionary
    var muscleLookup = muscleStatuses.ToDictionary(m => m.Name, m => m);

    // Count statuses
    var strongCount = muscleStatuses.Count(m => m.Status == "strong");
    var moderateCount = muscleStatuses.Count(m => m.Status == "moderate");
    var needsWorkCount = muscleStatuses.Count(m => m.Status == "needs-work");
    var totalMuscles = muscleStatuses.Count > 0 ? muscleStatuses.Count : 14;
    var strongPct = (int)Math.Round(strongCount * 100.0 / totalMuscles);
    var moderatePct = (int)Math.Round(moderateCount * 100.0 / totalMuscles);
    var needsWorkPct = 100 - strongPct - moderatePct;

    // Helper to get fill/stroke colors for a muscle
    string GetFill(string status) => status switch {
        "strong" => "rgba(34,197,94,0.25)",
        "moderate" => "rgba(255,107,53,0.25)",
        _ => "rgba(230,57,70,0.15)"
    };
    string GetStroke(string status) => status switch {
        "strong" => "rgba(34,197,94,0.6)",
        "moderate" => "rgba(255,107,53,0.6)",
        _ => "rgba(230,57,70,0.4)"
    };

    // Intensity ring calculation
    var circumference = 2 * Math.PI * 26; // r=26
    var intensityOffset = circumference - (stats.AvgIntensity / 100.0 * circumference);
}

<!-- ============================================================
     HERO SECTION
     ============================================================ -->
<section class="hero-section reveal" id="hero">
    <div class="hero-grid-overlay"></div>
    <div class="hero-particles">
        <span class="particle particle-1"></span>
        <span class="particle particle-2"></span>
        <span class="particle particle-3"></span>
        <span class="particle particle-4"></span>
        <span class="particle particle-5"></span>
        <span class="particle particle-6"></span>
        <span class="particle particle-7"></span>
        <span class="particle particle-8"></span>
    </div>

    <div class="container hero-container">
        <div class="hero-content">
            <h1 class="hero-heading">
                <span class="hero-line">
                    <span class="text-gradient">TRAIN</span> HARDER
                </span>
                <span class="hero-line">
                    <span class="text-gradient">TRACK</span> SMARTER
                </span>
            </h1>
            <p class="hero-subtitle">
                Your complete fitness command center. Monitor every muscle, optimize every rep.
            </p>
            <div class="hero-cta-group">
                <a asp-action="Index" asp-controller="Workout" class="btn-accent btn-lg hero-cta-primary">
                    <i class="fa-solid fa-bolt"></i> Start Workout
                </a>
                <a asp-action="Progress" asp-controller="Home" class="btn-ghost btn-lg hero-cta-secondary">
                    <i class="fa-solid fa-chart-line"></i> View Progress
                </a>
            </div>
        </div>
        <div class="hero-visual">
            <svg class="hero-hud-svg" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
                <!-- Outer rings -->
