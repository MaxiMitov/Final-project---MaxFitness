@{
    ViewData["Title"] = "Fitness Tracker - Dashboard";
}

<style>
    :root {
        --dark-bg: #0f111a;
        --card-bg: #1e2130;
        --accent-color: #00f2ff;
        --text-main: #ffffff;
        --text-muted: #a0a0a0;
        --progress-empty: #333644;
    }

    body {
        background-color: var(--dark-bg);
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
    }

    .dashboard-container {
        padding: 2rem 0;
    }

    .welcome-section {
        margin-bottom: 2.5rem;
    }

    .muscle-card {
        background: var(--card-bg);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .muscle-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
            border-color: var(--accent-color);
        }

    .muscle-icon {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: var(--accent-color);
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .progress-bar-container {
        background: var(--progress-empty);
        height: 8px;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .progress-fill {
        background: linear-gradient(90deg, #00f2ff, #0077ff);
        height: 100%;
        border-radius: 10px;
    }

    .stat-value {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .stat-desc {
        font-size: 0.8rem;
        color: var(--text-muted);
    }
</style>

<div class="container dashboard-container">
    <div class="welcome-section">
        <h1 class="display-5">Welcome back, <span style="color: var(--accent-color);">Alex</span></h1>
        <p class="text-muted">Here is your current physique progression summary.</p>
    </div>

    <div class="row mb-5">
        @foreach (var stat in new[] { ("Workouts", "5/6"), ("Streak", "12 Days"), ("Burned", "1,240"), ("Intensity", "84%") })
        {
            <div class="col-md-3">
                <div class="muscle-card text-center">
                    <div class="stat-desc">@stat.Item1</div>
                    <div class="stat-value">@stat.Item2</div>
                </div>
            </div>
        }
    </div>

    <h3 class="mb-4">Body Part Progress</h3>

    <div class="row g-4">
        <div class="col-md-4 col-lg-3">
            <div class="muscle-card">
                <div>
                    <div class="muscle-icon">⚡ Chest</div>
                    <div class="progress-label"><span>Growth</span><span>75%</span></div>
                    <div class="progress-bar-container"><div class="progress-fill" style="width: 75%;"></div></div>
                    <div class="stat-value">225 lbs</div>
                    <div class="stat-desc">Last PR: Bench Press</div>
                </div>
                <a asp-action="Chest" class="btn btn-outline-info btn-sm w-100 mt-3">View Details</a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="muscle-card">
                <div>
                    <div class="muscle-icon">📐 Back</div>
                    <div class="progress-label"><span>Growth</span><span>60%</span></div>
                    <div class="progress-bar-container"><div class="progress-fill" style="width: 60%;"></div></div>
                    <div class="stat-value">180 lbs</div>
                    <div class="stat-desc">Last PR: Lat Pulldown</div>
                </div>
                <a asp-action="Back" class="btn btn-outline-info btn-sm w-100 mt-3">View Details</a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="muscle-card">
                <div>
                    <div class="muscle-icon">🦵 Legs</div>
                    <div class="progress-label"><span>Growth</span><span>45%</span></div>
                    <div class="progress-bar-container"><div class="progress-fill" style="width: 45%;"></div></div>
                    <div class="stat-value">315 lbs</div>
                    <div class="stat-desc">Last PR: Squat</div>
                </div>
                <a asp-action="Legs" class="btn btn-outline-info btn-sm w-100 mt-3">View Details</a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="muscle-card">
                <div>
                    <div class="muscle-icon">💪 Arms</div>
                    <div class="progress-label"><span>Growth</span><span>90%</span></div>
                    <div class="progress-bar-container"><div class="progress-fill" style="width: 90%;"></div></div>
                    <div class="stat-value">45 lbs</div>
                    <div class="stat-desc">Last PR: Hammer Curls</div>
                </div>
                <a asp-action="Arms" class="btn btn-outline-info btn-sm w-100 mt-3">View Details</a>
            </div>
        </div>
    </div>
</div>