@page
@model Final_project___MaxFitness.Areas.Identity.Pages.Account.Manage.IndexModel

@{
    ViewData["Title"] = "Profile Dashboard";
    ViewData["ActivePage"] = "Index";
}

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4 shadow-sm border-primary">
            <div class="card-body">
                <h5 class="card-title text-primary">Overview</h5>
                <p class="card-text mb-1"><strong>Athlete:</strong> @Model.Username</p>
                <p class="card-text">
                    <strong>Most Trained Muscle:</strong>
                    <span class="badge bg-success fs-6">@Model.Stats.MostTrainedMuscle</span>
                </p>
            </div>
        </div>

        <h4 class="mb-3 text-secondary">Muscle Group Frequency</h4>
        <div class="row mb-4">
            @if (Model.Stats.MuscleTrainingCounts.Count > 0)
            {
                foreach (var stat in Model.Stats.MuscleTrainingCounts)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card bg-light text-center h-100 shadow-sm">
                            <div class="card-body py-4">
                                <h6 class="card-title text-uppercase text-muted fw-bold">@stat.MuscleGroup</h6>
                                <h2 class="card-text text-dark display-6 fw-bold">@stat.Count</h2>
                                <span class="text-muted small">Sessions</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted fst-italic">No workout data available yet. Start training!</p>
                </div>
            }
        </div>

        <h4 class="mb-3 text-secondary">Trophy Room</h4>
        <div class="row">
            @foreach (var ach in Model.Stats.Achievements)
            {
                <div class="col-md-6 mb-3">
                    <div class="card h-100 shadow-sm @(ach.IsUnlocked ? "border-warning" : "border-secondary bg-light text-muted")">
                        <div class="card-body d-flex align-items-center">
                            <div class="me-3 fs-1 fw-bold @(ach.IsUnlocked ? "text-warning" : "text-secondary")">
                                @(ach.IsUnlocked ? ach.Icon : "X")
                            </div>
                            <div>
                                <h5 class="card-title mb-1 fw-bold @(ach.IsUnlocked ? "text-dark" : "text-muted")">@ach.Name</h5>
                                <p class="card-text mb-0 small">@ach.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>