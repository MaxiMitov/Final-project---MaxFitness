<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaxFitness</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
</head>
<body>
    <!-- Page Transition Overlay -->
    <div class="page-transition-overlay" id="pageTransitionOverlay"></div>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-maxfit fixed-top" id="mainNavbar">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="logo-max">MAX</span><span class="logo-fitness">FITNESS</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav Content -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- Center Links -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link nav-link-maxfit" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-gauge-high me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-maxfit" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-dumbbell me-1"></i> Workouts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-maxfit" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chart-line me-1"></i> Progress
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-maxfit" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-apple-whole me-1"></i> Nutrition
                            </a>
                        </li>
                    </ul>

                    <!-- Right Side: Login + Profile -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-2">
                            <a class="nav-link nav-link-maxfit" href="#">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-maxfit d-flex align-items-center gap-2" href="#">
                                <div class="user-avatar">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                Profile
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer-maxfit">
        <div class="footer-gradient-line"></div>
        <div class="container">
            <div class="row gy-4 py-5">
                <!-- Column 1: Brand -->
                <div class="col-lg-3 col-md-6">
                    <div class="footer-brand">
                        <a class="d-inline-block mb-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                            <span class="logo-max">MAX</span><span class="logo-fitness">FITNESS</span>
                        </a>
                        <p class="footer-tagline">Push your limits. Track your gains.</p>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chevron-right me-1"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chevron-right me-1"></i> Workouts
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chevron-right me-1"></i> Progress
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chevron-right me-1"></i> Nutrition
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Column 3: Resources -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Resources</h6>
                    <ul class="footer-links">
                        <li>
                            <a href="#">
                                <i class="fa-solid fa-chevron-right me-1"></i> Blog
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="fa-solid fa-chevron-right me-1"></i> FAQ
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="fa-solid fa-chevron-right me-1"></i> Support
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="fa-solid fa-chevron-right me-1"></i> API
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Column 4: Connect -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Connect</h6>
                    <div class="footer-social">
                        <a href="#" class="social-icon" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="X (Twitter)">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="YouTube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>
                        <a href="#" class="social-icon" aria-label="Discord">
                            <i class="fa-brands fa-discord"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Bottom Bar -->
            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0">&copy; 2026 MaxFitness. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <p class="mb-0 footer-built-with">Built with discipline.</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Navbar scroll behavior -->
    <script>
        (function () {
            const navbar = document.getElementById('mainNavbar');
            if (!navbar) return;

            function handleScroll() {
                if (window.scrollY > 50) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            }

            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
