@{
    ViewData["Title"] = "Challenge Detail";

    T GetProp<T>(object obj, string prop, T fallback = default) {
        if (obj == null) return fallback;
        var pi = obj.GetType().GetProperty(prop);
        if (pi == null) return fallback;
        var val = pi.GetValue(obj);
        if (val == null) return fallback;
        try { return (T)Convert.ChangeType(val, typeof(T)); } catch { return fallback; }
    }

    var challenge      = ViewBag.Challenge;
    var isJoined       = ViewBag.IsJoined is bool b && b;
    var participants   = ViewBag.Participants as System.Collections.IList ?? new List<object>();
    var currentUser    = ViewBag.CurrentUser as string ?? "";

    var challengeId    = GetProp<int>(challenge, "Id", 0);
    var name           = GetProp<string>(challenge, "Name", "Challenge");
    var description    = GetProp<string>(challenge, "Description", "");
    var icon           = GetProp<string>(challenge, "Icon", "fa-fire");
    var color          = GetProp<string>(challenge, "Color", "#e63946");
    var durationDays   = GetProp<int>(challenge, "DurationDays", 30);
    var difficulty     = GetProp<string>(challenge, "Difficulty", "Medium");
    var participantCount = GetProp<int>(challenge, "ParticipantCount", 0);
    var rulesRaw       = GetProp<string>(challenge, "Rules", "");
    var startDateRaw   = GetProp<string>(challenge, "StartDate", DateTime.Now.ToString());
    var endDateRaw     = GetProp<string>(challenge, "EndDate", DateTime.Now.AddDays(30).ToString());

    DateTime.TryParse(startDateRaw, out DateTime startDate);
    DateTime.TryParse(endDateRaw,   out DateTime endDate);

    var daysRemaining  = (endDate - DateTime.Now).Days;
    if (daysRemaining < 0) daysRemaining = 0;

    var rules = rulesRaw.Split(';', StringSplitOptions.RemoveEmptyEntries);

    string diffColor = difficulty?.ToLower() switch {
        "easy"   => "#06d6a0",
        "medium" => "#ffd166",
        "hard"   => "#ff6b35",
        "elite"  => "#e63946",
        _        => "#8b8b9e"
    };

    int totalProgress = 0;
    foreach (var p in participants) {
        totalProgress += GetProp<int>(p, "Progress", 0);
    }
    int avgProgress = participants.Count > 0 ? totalProgress / participants.Count : 0;
}

<style>
    :root {
        --bg-primary:       #08080d;
        --bg-secondary:     #111118;
        --bg-card:          #16161f;
        --accent:           #e63946;
        --accent-secondary: #ff6b35;
        --accent-tertiary:  #ffd166;
        --text-primary:     #f8f8f8;
        --text-secondary:   #8b8b9e;
        --border:           rgba(255,255,255,0.07);
        --radius:           14px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: var(--bg-primary);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
    }

    /* ── BREADCRUMB ────────────────────────────────────────────────── */
    .cd-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .82rem;
        color: var(--text-secondary);
        margin-bottom: 28px;
    }
    .cd-breadcrumb a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color .2s;
    }
    .cd-breadcrumb a:hover { color: var(--text-primary); }
    .cd-breadcrumb .sep { opacity: .4; }
    .cd-breadcrumb .current { color: var(--text-primary); font-weight: 600; }

    /* ── PAGE WRAPPER ──────────────────────────────────────────────── */
    .cd-page {
        padding: 36px 0 80px;
        min-height: 100vh;
    }

    /* ── HERO CARD ─────────────────────────────────────────────────── */
    .cd-hero {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 48px 48px 40px;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
        animation: heroIn .55s cubic-bezier(.22,.68,0,1.2) both;
    }

    @@keyframes heroIn {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .cd-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 600px 300px at 50% -60px, var(--challenge-color, #e63946) 0%, transparent 70%);
        opacity: .12;
        pointer-events: none;
    }

    .cd-hero::after {
        content: '';
        position: absolute;
        top: -1px; left: 50%;
        transform: translateX(-50%);
        width: 200px; height: 2px;
        background: linear-gradient(90deg, transparent, var(--challenge-color, #e63946), transparent);
    }

    .cd-hero-inner {
        position: relative;
        z-index: 1;
    }

    .cd-hero-top {
        display: flex;
        align-items: flex-start;
        gap: 28px;
        margin-bottom: 28px;
    }

    .cd-icon-wrap {
        flex-shrink: 0;
        width: 88px; height: 88px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #fff;
        background: var(--challenge-color, #e63946);
        box-shadow: 0 0 36px 0 color-mix(in srgb, var(--challenge-color, #e63946) 55%, transparent);
        animation: iconPulse 3s ease-in-out infinite;
    }

    @@keyframes iconPulse {
        0%,100% { box-shadow: 0 0 36px 0 color-mix(in srgb, var(--challenge-color, #e63946) 55%, transparent); }
        50%      { box-shadow: 0 0 56px 8px color-mix(in srgb, var(--challenge-color, #e63946) 70%, transparent); }
    }

    .cd-hero-meta { flex: 1; min-width: 0; }

    .cd-hero-name {
        font-size: clamp(1.6rem, 4vw, 2.6rem);
        font-weight: 900;
        line-height: 1.15;
        letter-spacing: -.03em;
        background: linear-gradient(135deg, #fff 30%, var(--challenge-color, #e63946) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
    }

    .cd-hero-desc {
        color: var(--text-secondary);
        font-size: .97rem;
        line-height: 1.65;
        max-width: 680px;
    }

    /* ── INFO ROW ──────────────────────────────────────────────────── */
    .cd-info-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .cd-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: .8rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.04);
        color: var(--text-secondary);
    }

    .cd-badge i { font-size: .75rem; }

    .cd-badge-diff {
        color: var(--diff-color, #ffd166);
        border-color: color-mix(in srgb, var(--diff-color, #ffd166) 35%, transparent);
        background: color-mix(in srgb, var(--diff-color, #ffd166) 10%, transparent);
    }

    .cd-badge-participants {
        color: #a78bfa;
        border-color: rgba(167,139,250,.3);
        background: rgba(167,139,250,.08);
    }

    .cd-badge-date {
        color: var(--accent-tertiary);
        border-color: rgba(255,209,102,.25);
        background: rgba(255,209,102,.07);
    }

    /* ── JOIN / LEAVE BUTTON ───────────────────────────────────────── */
    .cd-join-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 34px;
        border-radius: 50px;
        border: none;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
        transition: transform .15s, box-shadow .2s, opacity .2s;
        position: relative;
        overflow: hidden;
    }

    .cd-join-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,.08);
        opacity: 0;
        transition: opacity .2s;
    }

    .cd-join-btn:hover::before { opacity: 1; }
    .cd-join-btn:hover { transform: translateY(-2px); }
    .cd-join-btn:active { transform: translateY(0); }

    .cd-join-btn.is-joined {
        background: linear-gradient(135deg, #06d6a0, #0aad82);
        color: #fff;
        box-shadow: 0 4px 24px rgba(6,214,160,.35);
    }

    .cd-join-btn.not-joined {
        background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
        color: #fff;
        box-shadow: 0 4px 24px rgba(230,57,70,.4);
    }

    .cd-join-btn:disabled {
        opacity: .6;
        cursor: not-allowed;
        transform: none;
    }

    /* ── TWO-COLUMN GRID ───────────────────────────────────────────── */
    .cd-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
        animation: fadeUp .5s .15s ease both;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── CARD BASE ─────────────────────────────────────────────────── */
    .cd-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 28px;
    }

    .cd-card-title {
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--text-secondary);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cd-card-title i { color: var(--accent); }

    /* ── RULES LIST ────────────────────────────────────────────────── */
    .cd-rules-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .cd-rule-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--border);
        transition: background .2s;
    }

    .cd-rule-item:hover { background: rgba(255,255,255,.045); }

    .cd-rule-num {
        flex-shrink: 0;
        width: 26px; height: 26px;
        border-radius: 50%;
        background: var(--challenge-color, #e63946);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        font-weight: 900;
        color: #fff;
        margin-top: 1px;
    }

    .cd-rule-check {
        flex-shrink: 0;
        color: #06d6a0;
        font-size: .9rem;
        margin-top: 3px;
    }

    .cd-rule-text {
        font-size: .9rem;
        color: var(--text-primary);
        line-height: 1.55;
    }

    /* ── STATS GRID ────────────────────────────────────────────────── */
    .cd-stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .cd-stat-box {
        background: rgba(255,255,255,.03);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px;
        text-align: center;
        transition: background .2s;
    }

    .cd-stat-box:hover { background: rgba(255,255,255,.05); }

    .cd-stat-value {
        font-size: 1.8rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 6px;
    }

    .cd-stat-label {
        font-size: .72rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ── PARTICIPANTS SECTION ──────────────────────────────────────── */
    .cd-participants {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        animation: fadeUp .5s .3s ease both;
    }

    .cd-participants-header {
        padding: 22px 28px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .cd-participants-title {
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cd-participants-title i { color: #a78bfa; }

    .cd-p-count {
        font-size: .78rem;
        font-weight: 700;
        color: var(--text-secondary);
        background: rgba(255,255,255,.05);
        padding: 4px 12px;
        border-radius: 50px;
        border: 1px solid var(--border);
    }

    .cd-p-row {
        display: grid;
        grid-template-columns: 44px 1fr 140px 180px;
        align-items: center;
        gap: 16px;
        padding: 14px 28px;
        border-bottom: 1px solid var(--border);
        transition: background .18s;
    }

    .cd-p-row:last-child { border-bottom: none; }

    .cd-p-row:hover { background: rgba(255,255,255,.03); }

    .cd-p-row.is-me {
        background: color-mix(in srgb, var(--challenge-color, #e63946) 8%, transparent);
        border-left: 3px solid var(--challenge-color, #e63946);
    }

    .cd-p-row.is-me:hover {
        background: color-mix(in srgb, var(--challenge-color, #e63946) 12%, transparent);
    }

    .cd-p-avatar {
        width: 38px; height: 38px;
        border-radius: 50%;
        background: var(--challenge-color, #e63946);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
    }

    .cd-p-name {
        font-size: .92rem;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
    }

    .cd-p-name .you-tag {
        font-size: .65rem;
        font-weight: 800;
        letter-spacing: .08em;
        padding: 2px 8px;
        border-radius: 50px;
        background: var(--challenge-color, #e63946);
        color: #fff;
    }

    .cd-p-joined {
        font-size: .78rem;
        color: var(--text-secondary);
        text-align: right;
    }

    .cd-p-progress-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cd-p-bar-bg {
        flex: 1;
        height: 6px;
        border-radius: 50px;
        background: rgba(255,255,255,.08);
        overflow: hidden;
    }

    .cd-p-bar-fill {
        height: 100%;
        border-radius: 50px;
        background: linear-gradient(90deg, var(--challenge-color, #e63946), color-mix(in srgb, var(--challenge-color, #e63946) 70%, #fff));
        transition: width .6s cubic-bezier(.22,.68,0,1.2);
    }

    .cd-p-pct {
        font-size: .75rem;
        font-weight: 700;
        color: var(--text-secondary);
        min-width: 34px;
        text-align: right;
        flex-shrink: 0;
    }

    /* ── EMPTY STATE ───────────────────────────────────────────────── */
    .cd-empty {
        padding: 48px 28px;
        text-align: center;
        color: var(--text-secondary);
        font-size: .9rem;
    }

    .cd-empty i {
        font-size: 2rem;
        margin-bottom: 12px;
        display: block;
        opacity: .4;
    }

    /* ── RESPONSIVE ────────────────────────────────────────────────── */
    @@media (max-width: 900px) {
        .cd-grid { grid-template-columns: 1fr; }
        .cd-hero { padding: 32px 24px 28px; }
        .cd-hero-top { gap: 18px; }
        .cd-icon-wrap { width: 66px; height: 66px; font-size: 1.7rem; }
        .cd-p-row { grid-template-columns: 38px 1fr 120px; }
        .cd-p-progress-wrap { display: none; }
    }

    @@media (max-width: 600px) {
        .cd-hero-top { flex-direction: column; align-items: center; text-align: center; }
        .cd-hero-desc { margin: 0 auto; }
        .cd-info-row { justify-content: center; }
        .cd-p-row { grid-template-columns: 38px 1fr; }
        .cd-p-joined { display: none; }
        .cd-stats-grid { grid-template-columns: 1fr 1fr; }
    }
</style>

<div class="cd-page">
    <div class="container">

        <!-- ── BREADCRUMB ────────────────────────────────────────── -->
        <nav class="cd-breadcrumb">
            <a href="/Home/Community"><i class="fa-solid fa-users"></i> Community</a>
            <span class="sep"><i class="fa-solid fa-chevron-right"></i></span>
            <span class="current">@name</span>
        </nav>

        <!-- ── HERO CARD ─────────────────────────────────────────── -->
        <div class="cd-hero" style="--challenge-color: @color">
            <div class="cd-hero-inner">
                <div class="cd-hero-top">
                    <div class="cd-icon-wrap">
                        <i class="fa-solid @icon"></i>
                    </div>
                    <div class="cd-hero-meta">
                        <h1 class="cd-hero-name">@name</h1>
                        <p class="cd-hero-desc">@description</p>
                    </div>
                </div>

                <!-- Info badges -->
                <div class="cd-info-row">
                    <span class="cd-badge">
                        <i class="fa-solid fa-calendar-days"></i>
                        @durationDays-Day Challenge
                    </span>
                    <span class="cd-badge cd-badge-diff" style="--diff-color: @diffColor">
                        <i class="fa-solid fa-signal"></i>
                        @difficulty
                    </span>
                    <span class="cd-badge cd-badge-participants">
                        <i class="fa-solid fa-users"></i>
                        @participantCount Participants
                    </span>
                    <span class="cd-badge cd-badge-date">
                        <i class="fa-solid fa-clock"></i>
                        @startDate.ToString("MMM d") &ndash; @endDate.ToString("MMM d, yyyy")
                    </span>
                </div>

                <!-- Join / Leave -->
                @if (isJoined)
                {
                    <button class="cd-join-btn is-joined" id="joinLeaveBtn" onclick="leaveChallenge(@challengeId)">
                        <i class="fa-solid fa-circle-check"></i> Joined
                    </button>
                }
                else
                {
                    <button class="cd-join-btn not-joined" id="joinLeaveBtn" onclick="joinChallenge(@challengeId)">
                        <i class="fa-solid fa-bolt"></i> Join Challenge
                    </button>
                }
            </div>
        </div>

        <!-- ── TWO-COLUMN GRID ──────────────────────────────────── -->
        <div class="cd-grid" style="--challenge-color: @color">

            <!-- LEFT: Rules & Guidelines -->
            <div class="cd-card">
                <div class="cd-card-title">
                    <i class="fa-solid fa-list-check"></i> Rules &amp; Guidelines
                </div>
                @if (rules.Length > 0)
                {
                    <ul class="cd-rules-list">
                        @for (int i = 0; i < rules.Length; i++)
                        {
                            <li class="cd-rule-item">
                                <div class="cd-rule-num" style="background: @color">@(i + 1)</div>
                                <i class="fa-solid fa-circle-check cd-rule-check"></i>
                                <span class="cd-rule-text">@rules[i].Trim()</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="cd-empty">
                        <i class="fa-solid fa-scroll"></i>
                        No rules defined for this challenge.
                    </div>
                }
            </div>

            <!-- RIGHT: Challenge Stats -->
            <div class="cd-card">
                <div class="cd-card-title">
                    <i class="fa-solid fa-chart-bar"></i> Challenge Stats
                </div>
                <div class="cd-stats-grid">
                    <div class="cd-stat-box">
                        <div class="cd-stat-value" style="color: #a78bfa">@participantCount</div>
                        <div class="cd-stat-label">Participants</div>
                    </div>
                    <div class="cd-stat-box">
                        <div class="cd-stat-value" style="color: @(daysRemaining > 7 ? "#06d6a0" : "#e63946")">@daysRemaining</div>
                        <div class="cd-stat-label">Days Left</div>
                    </div>
                    <div class="cd-stat-box">
                        <div class="cd-stat-value" style="color: var(--accent-tertiary)">@avgProgress%</div>
                        <div class="cd-stat-label">Avg Progress</div>
                    </div>
                    <div class="cd-stat-box">
                        <div class="cd-stat-value" style="color: @diffColor; font-size: 1.1rem; padding-top: 6px;">@difficulty</div>
                        <div class="cd-stat-label">Difficulty</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ── PARTICIPANTS SECTION ──────────────────────────────── -->
        <div class="cd-participants" style="--challenge-color: @color">
            <div class="cd-participants-header">
                <div class="cd-participants-title">
                    <i class="fa-solid fa-ranking-star"></i> Participants
                </div>
                <span class="cd-p-count">@participants.Count enrolled</span>
            </div>

            @if (participants.Count > 0)
            {
                foreach (var p in participants)
                {
                    var uName     = GetProp<string>(p, "UserName", "User");
                    var joinedAt  = GetProp<string>(p, "JoinedAt", "");
                    var progress  = GetProp<int>(p, "Progress", 0);
                    var pct       = durationDays > 0 ? Math.Min(100, (int)Math.Round(progress / (double)durationDays * 100)) : 0;
                    var isMe      = string.Equals(uName, currentUser, StringComparison.OrdinalIgnoreCase);
                    var letter    = uName.Length > 0 ? uName[0].ToString().ToUpper() : "?";
                    <div class="cd-p-row @(isMe ? "is-me" : "")">
                        <div class="cd-p-avatar" style="background: @color">@letter</div>
                        <div class="cd-p-name">
                            @uName
                            @if (isMe) { <span class="you-tag">YOU</span> }
                        </div>
                        <div class="cd-p-joined">
                            <i class="fa-regular fa-calendar" style="margin-right:5px; opacity:.5;"></i>@joinedAt
                        </div>
                        <div class="cd-p-progress-wrap">
                            <div class="cd-p-bar-bg">
                                <div class="cd-p-bar-fill" style="width: @pct%"></div>
                            </div>
                            <span class="cd-p-pct">@pct%</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="cd-empty">
                    <i class="fa-solid fa-users-slash"></i>
                    No participants yet. Be the first to join!
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
<script>
    async function joinChallenge(id) {
        const btn = document.getElementById('joinLeaveBtn');
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Joining...';
        try {
            const res = await fetch('/Home/JoinChallenge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ challengeId: id })
            });
            if (res.ok) {
                location.reload();
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Join Challenge';
            }
        } catch (e) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-bolt"></i> Join Challenge';
        }
    }

    async function leaveChallenge(id) {
        const btn = document.getElementById('joinLeaveBtn');
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Leaving...';
        try {
            const res = await fetch('/Home/LeaveChallenge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ challengeId: id })
            });
            if (res.ok) {
                location.reload();
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Joined';
            }
        } catch (e) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> Joined';
        }
    }
</script>
}
