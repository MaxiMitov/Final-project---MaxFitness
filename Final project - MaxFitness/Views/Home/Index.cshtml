@{
    ViewData["Title"] = "Dashboard";
    var stats = ViewBag.Stats as Final_project___MaxFitness.Models.DashboardStats ?? new Final_project___MaxFitness.Models.DashboardStats();
    var muscleStatuses = ViewBag.MuscleStatuses as List<Final_project___MaxFitness.Models.MuscleStatus> ?? new List<Final_project___MaxFitness.Models.MuscleStatus>();
    var recentWorkouts = ViewBag.RecentWorkouts as List<Final_project___MaxFitness.Models.RecentWorkout> ?? new List<Final_project___MaxFitness.Models.RecentWorkout>();

    // Build muscle lookup dictionary
    var muscleLookup = muscleStatuses.ToDictionary(m => m.Name, m => m);

    // Count statuses
    var strongCount = muscleStatuses.Count(m => m.Status == "strong");
    var moderateCount = muscleStatuses.Count(m => m.Status == "moderate");
    var needsWorkCount = muscleStatuses.Count(m => m.Status == "needs-work");
    var totalMuscles = muscleStatuses.Count > 0 ? muscleStatuses.Count : 14;
    var strongPct = (int)Math.Round(strongCount * 100.0 / totalMuscles);
    var moderatePct = (int)Math.Round(moderateCount * 100.0 / totalMuscles);
    var needsWorkPct = 100 - strongPct - moderatePct;

    // Helper to get fill/stroke colors for a muscle
    string GetFill(string status) => status switch {
        "strong" => "rgba(34,197,94,0.25)",
        "moderate" => "rgba(255,107,53,0.25)",
        _ => "rgba(230,57,70,0.15)"
    };
    string GetStroke(string status) => status switch {
        "strong" => "rgba(34,197,94,0.6)",
        "moderate" => "rgba(255,107,53,0.6)",
        _ => "rgba(230,57,70,0.4)"
    };

    // Intensity ring calculation
    var circumference = 2 * Math.PI * 26; // r=26
    var intensityOffset = circumference - (stats.AvgIntensity / 100.0 * circumference);

    // Weekly goal ring
    var goalCircumference = 2 * Math.PI * 20; // r=20
    var goalOffset = goalCircumference - (stats.WeeklyProgressPercent / 100.0 * goalCircumference);

    // Today's date
    var todayFormatted = DateTime.Now.ToString("dddd, MMMM d");
    var remaining = Math.Max(0, stats.WeeklyGoal - stats.WeeklyWorkouts);
}

<!-- ============================================================
     WELCOME HEADER
     ============================================================ -->
<section class="welcome-section reveal" id="welcome">
    <div class="container">
        <div class="welcome-inner">
            <div class="welcome-left">
                <p class="welcome-date">@todayFormatted</p>
                <h1 class="welcome-heading">
                    Welcome back, <span class="text-gradient">@(User.Identity?.Name ?? "Athlete")</span>
                </h1>
                <p class="welcome-sub">
                    @if (stats.Streak >= 7)
                    {
                        <span><i class="fa-solid fa-fire" style="color: #ff6b35;"></i> You're on a <strong>@stats.Streak-day streak</strong> — keep the momentum going.</span>
                    }
                    else if (stats.WeeklyWorkouts >= stats.WeeklyGoal)
                    {
                        <span><i class="fa-solid fa-trophy" style="color: #ffd166;"></i> Weekly goal reached. Outstanding work this week.</span>
                    }
                    else
                    {
                        <span>@(remaining == 0 ? "All goals met — rest or push further." : $"{remaining} workout{(remaining == 1 ? "" : "s")} left to hit your weekly goal.")</span>
                    }
                </p>
            </div>
            <div class="welcome-right">
                <a asp-action="Index" asp-controller="Workout" class="btn-accent btn-lg">
                    <i class="fa-solid fa-bolt"></i> Start Workout
                </a>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     QUICK STATS ROW
     ============================================================ -->
<section class="stats-section reveal-up" id="quick-stats">
    <div class="container">
        <div class="stat-grid">

            <!-- Weekly Workouts -->
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-ring-wrap">
                        <svg viewBox="0 0 50 50" class="stat-ring-svg">
                            <defs>
                                <linearGradient id="ringGradGoal" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#e63946" />
                                    <stop offset="100%" stop-color="#ff6b35" />
                                </linearGradient>
                            </defs>
                            <circle cx="25" cy="25" r="20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="4" />
                            <circle cx="25" cy="25" r="20" fill="none" stroke="url(#ringGradGoal)" stroke-width="4"
                                    stroke-dasharray="@goalCircumference.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    stroke-dashoffset="@goalOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    stroke-linecap="round" transform="rotate(-90 25 25)" />
                        </svg>
                        <span class="stat-ring-value">@stats.WeeklyWorkouts</span>
                    </div>
                    <div class="stat-card-text">
                        <span class="stat-label">Weekly Workouts</span>
                        <span class="stat-value">@stats.WeeklyWorkouts<span class="stat-unit"> / @stats.WeeklyGoal</span></span>
                        <span class="stat-detail">@(remaining == 0 ? "Goal complete" : $"{remaining} to go")</span>
                    </div>
                </div>
                <div class="stat-bar-track">
                    <div class="stat-bar-fill" style="width: @(stats.WeeklyProgressPercent)%;"></div>
                </div>
            </div>

            <!-- Active Streak -->
            <div class="stat-card stat-card--fire">
                <div class="stat-card-top">
                    <div class="stat-icon-box stat-icon-box--fire">
                        <i class="fa-solid fa-fire"></i>
                    </div>
                    <div class="stat-card-text">
                        <span class="stat-label">Active Streak</span>
                        <span class="stat-value">@stats.Streak<span class="stat-unit"> @(stats.Streak == 1 ? "day" : "days")</span></span>
                        @if (stats.Streak >= 7)
                        {
                            <span class="stat-badge stat-badge--gold"><i class="fa-solid fa-trophy"></i> On Fire</span>
                        }
                        else
                        {
                            <span class="stat-detail">Keep going!</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Calories Burned -->
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-icon-box stat-icon-box--cal">
                        <i class="fa-solid fa-bolt-lightning"></i>
                    </div>
                    <div class="stat-card-text">
                        <span class="stat-label">Calories Burned</span>
                        <span class="stat-value">@stats.CaloriesThisWeek.ToString("N0")</span>
                        <span class="stat-detail">This week</span>
                    </div>
                </div>
            </div>

            <!-- Avg Intensity -->
            <div class="stat-card">
                <div class="stat-card-top">
                    <div class="stat-ring-wrap">
                        <svg viewBox="0 0 60 60" class="stat-ring-svg stat-ring-svg--lg">
                            <defs>
                                <linearGradient id="intensityGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#e63946" />
                                    <stop offset="100%" stop-color="#ff6b35" />
                                </linearGradient>
                            </defs>
                            <circle cx="30" cy="30" r="26" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="5" />
                            <circle cx="30" cy="30" r="26" fill="none" stroke="url(#intensityGrad)" stroke-width="5"
                                    stroke-dasharray="@circumference.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    stroke-dashoffset="@intensityOffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    stroke-linecap="round" transform="rotate(-90 30 30)" />
                        </svg>
                        <span class="stat-ring-value stat-ring-value--lg">@stats.AvgIntensity<span style="font-size:0.6em">%</span></span>
                    </div>
                    <div class="stat-card-text">
                        <span class="stat-label">Avg Intensity</span>
                        <span class="stat-value">@stats.AvgIntensity<span class="stat-unit">%</span></span>
                        <span class="stat-detail">This week</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- ============================================================
     TWO-COLUMN MAIN AREA
     ============================================================ -->
<section class="main-section" id="main-content">
    <div class="container">
        <div class="main-grid">

            <!-- ===== LEFT COLUMN ===== -->
            <div class="main-left">

                <!-- Quick Actions -->
                <div class="panel reveal-up" id="quick-actions">
                    <div class="panel-header">
                        <h2 class="panel-title">Quick Actions</h2>
                    </div>
                    <div class="action-cards">
                        <a asp-action="Index" asp-controller="Workout" class="action-card action-card--primary">
                            <div class="action-card-icon">
                                <i class="fa-solid fa-dumbbell"></i>
                            </div>
                            <div class="action-card-body">
                                <span class="action-card-title">Start Workout</span>
                                <span class="action-card-desc">Jump into your next session</span>
                            </div>
                            <i class="fa-solid fa-arrow-right action-card-arrow"></i>
                        </a>
                        <a href="#body-map" class="action-card" id="bodyMapActionBtn">
                            <div class="action-card-icon action-card-icon--secondary">
                                <i class="fa-solid fa-person"></i>
                            </div>
                            <div class="action-card-body">
                                <span class="action-card-title">Body Map</span>
                                <span class="action-card-desc">View muscle group status</span>
                            </div>
                            <i class="fa-solid fa-arrow-right action-card-arrow"></i>
                        </a>
                        <a asp-action="Chest" asp-controller="Home" class="action-card">
                            <div class="action-card-icon action-card-icon--neutral">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <div class="action-card-body">
                                <span class="action-card-title">My Progress</span>
                                <span class="action-card-desc">Track your muscle gains</span>
                            </div>
                            <i class="fa-solid fa-arrow-right action-card-arrow"></i>
                        </a>
                    </div>
                </div>

                <!-- Recent Workouts -->
                <div class="panel reveal-up" id="recent-workouts-panel">
                    <div class="panel-header">
                        <h2 class="panel-title">Recent Workouts</h2>
                        @if (recentWorkouts.Count > 0)
                        {
                            <span class="panel-badge">@recentWorkouts.Count</span>
                        }
                    </div>

                    @if (recentWorkouts.Count == 0)
                    {
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fa-solid fa-dumbbell"></i>
                            </div>
                            <p class="empty-state-title">No workouts yet</p>
                            <p class="empty-state-desc">Complete your first session to see your history here.</p>
                            <a asp-action="Index" asp-controller="Workout" class="btn-accent btn-sm">
                                <i class="fa-solid fa-play"></i> Start Now
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="workout-list">
                            @{
                                var iconPool = new[] { "fa-solid fa-dumbbell", "fa-solid fa-person-walking", "fa-solid fa-bolt", "fa-solid fa-hand-fist", "fa-solid fa-arrow-up-from-bracket" };
                                var iconColorPool = new[] { "wicon--red", "wicon--orange", "wicon--green", "wicon--yellow", "wicon--red" };
                            }
                            @foreach (var (workout, idx) in recentWorkouts.Select((w, i) => (w, i)))
                            {
                                var iIdx = idx % iconPool.Length;
                                var intensityClass = workout.IntensityLabel switch {
                                    "Light" => "ibadge--light",
                                    "Moderate" => "ibadge--moderate",
                                    "High" => "ibadge--high",
                                    "Extreme" => "ibadge--extreme",
                                    _ => "ibadge--moderate"
                                };
                                var workoutName = string.Join(" & ", workout.MuscleGroups.Select(m => char.ToUpper(m[0]) + m.Substring(1)).Take(2));
                                if (string.IsNullOrEmpty(workoutName)) { workoutName = "Workout"; }

                                <div class="workout-row">
                                    <div class="workout-row-icon @iconColorPool[iIdx]">
                                        <i class="@iconPool[iIdx]"></i>
                                    </div>
                                    <div class="workout-row-info">
                                        <span class="workout-row-name">@workoutName</span>
                                        <div class="workout-row-tags">
                                            @foreach (var mg in workout.MuscleGroups.Take(3))
                                            {
                                                <span class="muscle-tag">@mg</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="workout-row-meta">
                                        <span class="workout-row-time">@workout.TimeAgo</span>
                                        <div class="workout-row-stats">
                                            <span><i class="fa-regular fa-clock"></i> @workout.DurationMinutes min</span>
                                            <span><i class="fa-solid fa-list-check"></i> @workout.ExerciseCount ex</span>
                                        </div>
                                    </div>
                                    <span class="intensity-badge @intensityClass">@workout.IntensityLabel</span>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>

            <!-- ===== RIGHT SIDEBAR ===== -->
            <div class="main-right">

                <!-- Muscle Overview -->
                <div class="panel reveal-up" id="muscle-overview-panel">
                    <div class="panel-header">
                        <h2 class="panel-title">Muscle Overview</h2>
                        <a href="#body-map" class="panel-link">View Map <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                    <div class="muscle-overview-grid">
                        @{
                            var overviewMuscles = new[] {
                                ("Chest (Left)", "Chest"),
                                ("Back", "Back"),
                                ("Left Quad", "Quads"),
                                ("Left Shoulder", "Shoulders"),
                                ("Abs", "Core"),
                                ("Left Bicep", "Arms"),
                                ("Left Calf", "Calves"),
                                ("Traps", "Traps")
                            };
                        }
                        @foreach (var (key, label) in overviewMuscles)
                        {
                            var mStatus = muscleLookup.GetValueOrDefault(key);
                            var dotClass = mStatus?.Status switch {
                                "strong" => "mdot--strong",
                                "moderate" => "mdot--moderate",
                                _ => "mdot--needs-work"
                            };
                            var barWidth = mStatus?.Status switch {
                                "strong" => 90,
                                "moderate" => 55,
                                _ => 20
                            };
                            <div class="muscle-overview-row">
                                <span class="mdot @dotClass"></span>
                                <span class="muscle-overview-name">@label</span>
                                <div class="muscle-overview-bar-track">
                                    <div class="muscle-overview-bar-fill @dotClass" style="width: @(barWidth)%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="muscle-overview-legend">
                        <span class="legend-pill legend-pill--strong">Strong</span>
                        <span class="legend-pill legend-pill--moderate">Moderate</span>
                        <span class="legend-pill legend-pill--needs-work">Needs Work</span>
                    </div>
                </div>

                <!-- Achievements -->
                <div class="panel reveal-up" id="achievements-panel">
                    <div class="panel-header">
                        <h2 class="panel-title">Achievements</h2>
                    </div>
                    <div class="achieve-list">
                        <!-- Iron Will -->
                        <div class="achieve-row achieve-row--unlocked">
                            <div class="achieve-icon achieve-icon--gold">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div class="achieve-info">
                                <span class="achieve-name">Iron Will</span>
                                <div class="achieve-bar-track">
                                    <div class="achieve-bar-fill achieve-bar-fill--complete" style="width: 100%;"></div>
                                </div>
                                <span class="achieve-label">7 / 7 days</span>
                            </div>
                            <span class="achieve-badge achieve-badge--done"><i class="fa-solid fa-check"></i></span>
                        </div>
                        <!-- Beast Mode -->
                        <div class="achieve-row">
                            <div class="achieve-icon achieve-icon--accent">
                                <i class="fa-solid fa-dragon"></i>
                            </div>
                            <div class="achieve-info">
                                <span class="achieve-name">Beast Mode</span>
                                <div class="achieve-bar-track">
                                    <div class="achieve-bar-fill" style="width: 84%;"></div>
                                </div>
                                <span class="achieve-label">42 / 50 workouts</span>
                            </div>
                            <span class="achieve-pct">84%</span>
                        </div>
                        <!-- Consistency King -->
                        <div class="achieve-row">
                            <div class="achieve-icon achieve-icon--accent">
                                <i class="fa-solid fa-crown"></i>
                            </div>
                            <div class="achieve-info">
                                <span class="achieve-name">Consistency King</span>
                                <div class="achieve-bar-track">
                                    <div class="achieve-bar-fill" style="width: 40%;"></div>
                                </div>
                                <span class="achieve-label">12 / 30 days</span>
                            </div>
                            <span class="achieve-pct">40%</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     INTERACTIVE BODY MAP SECTION
     ============================================================ -->
<section class="body-map-section reveal-up" id="body-map">
    <div class="container">
        <div class="section-header">
            <div class="section-header-left">
                <h2 class="section-title">Muscle <span class="text-gradient">Status Map</span></h2>
                <p class="section-subtitle">Hover any muscle to see readiness details</p>
            </div>
            <div class="section-header-right">
                <div class="status-summary-pills">
                    <span class="status-pill status-pill--strong"><span class="spill-dot"></span> @strongCount Strong</span>
                    <span class="status-pill status-pill--moderate"><span class="spill-dot"></span> @moderateCount Moderate</span>
                    <span class="status-pill status-pill--needs-work"><span class="spill-dot"></span> @needsWorkCount Needs Work</span>
                </div>
            </div>
        </div>

        <div class="body-map-layout">
            <!-- Body Map SVG -->
            <div class="body-map-container">
                <div class="body-map-glow"></div>
                <svg viewBox="0 0 300 520" class="body-map-svg" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <filter id="muscleGlow" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="4" result="blur" />
                            <feComposite in="SourceGraphic" in2="blur" operator="over" />
                        </filter>
                        <filter id="activeGlow" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="8" result="blur" />
                            <feMerge>
                                <feMergeNode in="blur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                        <linearGradient id="muscleGradStrong" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="rgba(34,197,94,0.35)" />
                            <stop offset="100%" stop-color="rgba(34,197,94,0.15)" />
                        </linearGradient>
                        <linearGradient id="muscleGradModerate" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="rgba(255,107,53,0.35)" />
                            <stop offset="100%" stop-color="rgba(255,107,53,0.15)" />
                        </linearGradient>
                        <linearGradient id="muscleGradNeedsWork" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="rgba(230,57,70,0.35)" />
                            <stop offset="100%" stop-color="rgba(230,57,70,0.15)" />
                        </linearGradient>
                    </defs>

                    <!-- Body silhouette -->
                    <g class="body-silhouette" opacity="0.07">
                        <ellipse cx="150" cy="42" rx="32" ry="36" fill="white" />
                        <rect x="135" y="72" width="30" height="24" rx="6" fill="white" />
                        <path d="M100,96 Q90,96 80,110 L70,140 L65,180 L68,230 L105,240 L130,235 L150,232 L170,235 L195,240 L232,230 L235,180 L230,140 L220,110 Q210,96 200,96 Z" fill="white" />
                        <path d="M80,110 Q60,115 55,140 L50,180 L48,220 L52,250 L60,258 L70,250 L75,220 L80,180 Z" fill="white" />
                        <path d="M220,110 Q240,115 245,140 L250,180 L252,220 L248,250 L240,258 L230,250 L225,220 L220,180 Z" fill="white" />
                        <path d="M108,235 L100,290 L95,345 L96,400 L100,440 L105,470 L112,480 L130,480 L135,470 L138,440 L140,400 L142,345 L145,290 L148,240 Z" fill="white" />
                        <path d="M192,235 L200,290 L205,345 L204,400 L200,440 L195,470 L188,480 L170,480 L165,470 L162,440 L160,400 L158,345 L155,290 L152,240 Z" fill="white" />
                    </g>

                    <!-- MUSCLE GROUPS -->

                    @{ var nk = muscleLookup.GetValueOrDefault("Neck"); }
                    <ellipse class="muscle-group" data-muscle="Neck"
                             data-status="@(nk?.Status ?? "needs-work")" data-last-trained="@(nk?.LastTrained ?? "Never")" data-exercises="@(nk?.ExerciseCount ?? 0)"
                             cx="150" cy="45" rx="28" ry="32"
                             fill="@GetFill(nk?.Status ?? "needs-work")" stroke="@GetStroke(nk?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var tr = muscleLookup.GetValueOrDefault("Traps"); }
                    <rect class="muscle-group" data-muscle="Traps"
                          data-status="@(tr?.Status ?? "needs-work")" data-last-trained="@(tr?.LastTrained ?? "Never")" data-exercises="@(tr?.ExerciseCount ?? 0)"
                          x="133" y="74" width="34" height="20" rx="5"
                          fill="@GetFill(tr?.Status ?? "needs-work")" stroke="@GetStroke(tr?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var ls = muscleLookup.GetValueOrDefault("Left Shoulder"); }
                    <ellipse class="muscle-group" data-muscle="Left Shoulder"
                             data-status="@(ls?.Status ?? "needs-work")" data-last-trained="@(ls?.LastTrained ?? "Never")" data-exercises="@(ls?.ExerciseCount ?? 0)"
                             cx="93" cy="105" rx="27" ry="18"
                             fill="@GetFill(ls?.Status ?? "needs-work")" stroke="@GetStroke(ls?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var rs = muscleLookup.GetValueOrDefault("Right Shoulder"); }
                    <ellipse class="muscle-group" data-muscle="Right Shoulder"
                             data-status="@(rs?.Status ?? "needs-work")" data-last-trained="@(rs?.LastTrained ?? "Never")" data-exercises="@(rs?.ExerciseCount ?? 0)"
                             cx="207" cy="105" rx="27" ry="18"
                             fill="@GetFill(rs?.Status ?? "needs-work")" stroke="@GetStroke(rs?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var cl = muscleLookup.GetValueOrDefault("Chest (Left)"); }
                    <path class="muscle-group" data-muscle="Chest (Left)"
                          data-status="@(cl?.Status ?? "needs-work")" data-last-trained="@(cl?.LastTrained ?? "Never")" data-exercises="@(cl?.ExerciseCount ?? 0)"
                          d="M108,112 Q105,98 150,96 L150,158 Q110,156 108,142 Z"
                          fill="@GetFill(cl?.Status ?? "needs-work")" stroke="@GetStroke(cl?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var cr = muscleLookup.GetValueOrDefault("Chest (Right)"); }
                    <path class="muscle-group" data-muscle="Chest (Right)"
                          data-status="@(cr?.Status ?? "needs-work")" data-last-trained="@(cr?.LastTrained ?? "Never")" data-exercises="@(cr?.ExerciseCount ?? 0)"
                          d="M192,112 Q195,98 150,96 L150,158 Q190,156 192,142 Z"
                          fill="@GetFill(cr?.Status ?? "needs-work")" stroke="@GetStroke(cr?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var lb = muscleLookup.GetValueOrDefault("Left Bicep"); }
                    <ellipse class="muscle-group" data-muscle="Left Bicep"
                             data-status="@(lb?.Status ?? "needs-work")" data-last-trained="@(lb?.LastTrained ?? "Never")" data-exercises="@(lb?.ExerciseCount ?? 0)"
                             cx="76" cy="155" rx="14" ry="32"
                             fill="@GetFill(lb?.Status ?? "needs-work")" stroke="@GetStroke(lb?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var rb = muscleLookup.GetValueOrDefault("Right Bicep"); }
                    <ellipse class="muscle-group" data-muscle="Right Bicep"
                             data-status="@(rb?.Status ?? "needs-work")" data-last-trained="@(rb?.LastTrained ?? "Never")" data-exercises="@(rb?.ExerciseCount ?? 0)"
                             cx="224" cy="155" rx="14" ry="32"
                             fill="@GetFill(rb?.Status ?? "needs-work")" stroke="@GetStroke(rb?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var lf = muscleLookup.GetValueOrDefault("Left Forearm"); }
                    <ellipse class="muscle-group" data-muscle="Left Forearm"
                             data-status="@(lf?.Status ?? "needs-work")" data-last-trained="@(lf?.LastTrained ?? "Never")" data-exercises="@(lf?.ExerciseCount ?? 0)"
                             cx="70" cy="218" rx="12" ry="30"
                             fill="@GetFill(lf?.Status ?? "needs-work")" stroke="@GetStroke(lf?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var rf = muscleLookup.GetValueOrDefault("Right Forearm"); }
                    <ellipse class="muscle-group" data-muscle="Right Forearm"
                             data-status="@(rf?.Status ?? "needs-work")" data-last-trained="@(rf?.LastTrained ?? "Never")" data-exercises="@(rf?.ExerciseCount ?? 0)"
                             cx="230" cy="218" rx="12" ry="30"
                             fill="@GetFill(rf?.Status ?? "needs-work")" stroke="@GetStroke(rf?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var ab = muscleLookup.GetValueOrDefault("Abs"); }
                    <rect class="muscle-group" data-muscle="Abs"
                          data-status="@(ab?.Status ?? "needs-work")" data-last-trained="@(ab?.LastTrained ?? "Never")" data-exercises="@(ab?.ExerciseCount ?? 0)"
                          x="131" y="162" width="38" height="64" rx="6"
                          fill="@GetFill(ab?.Status ?? "needs-work")" stroke="@GetStroke(ab?.Status ?? "needs-work")" stroke-width="1.2" />

                    <!-- Abs detail lines -->
                    <line x1="134" y1="180" x2="166" y2="180" stroke="rgba(230,57,70,0.2)" stroke-width="0.8" pointer-events="none" />
                    <line x1="134" y1="196" x2="166" y2="196" stroke="rgba(230,57,70,0.2)" stroke-width="0.8" pointer-events="none" />
                    <line x1="134" y1="212" x2="166" y2="212" stroke="rgba(230,57,70,0.2)" stroke-width="0.8" pointer-events="none" />
                    <line x1="150" y1="163" x2="150" y2="225" stroke="rgba(230,57,70,0.15)" stroke-width="0.8" pointer-events="none" />

                    @{ var lo = muscleLookup.GetValueOrDefault("Left Oblique"); }
                    <rect class="muscle-group" data-muscle="Left Oblique"
                          data-status="@(lo?.Status ?? "needs-work")" data-last-trained="@(lo?.LastTrained ?? "Never")" data-exercises="@(lo?.ExerciseCount ?? 0)"
                          x="110" y="167" width="18" height="55" rx="5"
                          fill="@GetFill(lo?.Status ?? "needs-work")" stroke="@GetStroke(lo?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var ro = muscleLookup.GetValueOrDefault("Right Oblique"); }
                    <rect class="muscle-group" data-muscle="Right Oblique"
                          data-status="@(ro?.Status ?? "needs-work")" data-last-trained="@(ro?.LastTrained ?? "Never")" data-exercises="@(ro?.ExerciseCount ?? 0)"
                          x="172" y="167" width="18" height="55" rx="5"
                          fill="@GetFill(ro?.Status ?? "needs-work")" stroke="@GetStroke(ro?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var lq = muscleLookup.GetValueOrDefault("Left Quad"); }
                    <ellipse class="muscle-group" data-muscle="Left Quad"
                             data-status="@(lq?.Status ?? "needs-work")" data-last-trained="@(lq?.LastTrained ?? "Never")" data-exercises="@(lq?.ExerciseCount ?? 0)"
                             cx="127" cy="295" rx="22" ry="52"
                             fill="@GetFill(lq?.Status ?? "needs-work")" stroke="@GetStroke(lq?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var rq = muscleLookup.GetValueOrDefault("Right Quad"); }
                    <ellipse class="muscle-group" data-muscle="Right Quad"
                             data-status="@(rq?.Status ?? "needs-work")" data-last-trained="@(rq?.LastTrained ?? "Never")" data-exercises="@(rq?.ExerciseCount ?? 0)"
                             cx="173" cy="295" rx="22" ry="52"
                             fill="@GetFill(rq?.Status ?? "needs-work")" stroke="@GetStroke(rq?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var lc = muscleLookup.GetValueOrDefault("Left Calf"); }
                    <ellipse class="muscle-group" data-muscle="Left Calf"
                             data-status="@(lc?.Status ?? "needs-work")" data-last-trained="@(lc?.LastTrained ?? "Never")" data-exercises="@(lc?.ExerciseCount ?? 0)"
                             cx="123" cy="405" rx="16" ry="44"
                             fill="@GetFill(lc?.Status ?? "needs-work")" stroke="@GetStroke(lc?.Status ?? "needs-work")" stroke-width="1.2" />

                    @{ var rc = muscleLookup.GetValueOrDefault("Right Calf"); }
                    <ellipse class="muscle-group" data-muscle="Right Calf"
                             data-status="@(rc?.Status ?? "needs-work")" data-last-trained="@(rc?.LastTrained ?? "Never")" data-exercises="@(rc?.ExerciseCount ?? 0)"
                             cx="177" cy="405" rx="16" ry="44"
                             fill="@GetFill(rc?.Status ?? "needs-work")" stroke="@GetStroke(rc?.Status ?? "needs-work")" stroke-width="1.2" />

                    <!-- Scan line -->
                    <line class="body-scan-line" x1="40" y1="0" x2="260" y2="0" stroke="rgba(230,57,70,0.15)" stroke-width="1" pointer-events="none" />
                </svg>
            </div>

            <!-- Info Panel -->
            <div class="body-map-info-panel">
                <!-- Legend -->
                <div class="bm-card">
                    <h3 class="bm-card-title">Legend</h3>
                    <div class="bm-legend">
                        <div class="bm-legend-item">
                            <span class="legend-dot legend-dot--strong"></span>
                            <div>
                                <span class="bm-legend-label">Strong</span>
                                <span class="bm-legend-desc">Trained recently</span>
                            </div>
                        </div>
                        <div class="bm-legend-item">
                            <span class="legend-dot legend-dot--moderate"></span>
                            <div>
                                <span class="bm-legend-label">Moderate</span>
                                <span class="bm-legend-desc">Could use a session</span>
                            </div>
                        </div>
                        <div class="bm-legend-item">
                            <span class="legend-dot legend-dot--needs-work"></span>
                            <div>
                                <span class="bm-legend-label">Needs Work</span>
                                <span class="bm-legend-desc">Overdue training</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hover detail panel -->
                <div class="bm-card bm-detail-card" id="muscleDetailPanel">
                    <div class="muscle-detail-empty" id="muscleDetailEmpty">
                        <i class="fa-regular fa-hand-pointer"></i>
                        <p>Hover a muscle group</p>
                    </div>
                    <div class="muscle-detail-content" id="muscleDetailContent" style="display: none;">
                        <h4 class="muscle-detail-name" id="muscleName">--</h4>
                        <span class="muscle-detail-status" id="muscleStatus">--</span>
                        <div class="muscle-detail-rows">
                            <div class="muscle-detail-row">
                                <i class="fa-regular fa-clock"></i>
                                <span>Last Trained</span>
                                <strong id="muscleLastTrained">--</strong>
                            </div>
                            <div class="muscle-detail-row">
                                <i class="fa-solid fa-list-check"></i>
                                <span>Exercises</span>
                                <strong id="muscleExercises">--</strong>
                            </div>
                        </div>
                        <a href="#" class="btn-accent btn-sm muscle-detail-cta" id="muscleTrainBtn">
                            <i class="fa-solid fa-play"></i> Train This Muscle
                        </a>
                    </div>
                </div>

                <!-- Overview stats -->
                <div class="bm-card">
                    <h3 class="bm-card-title">Overview</h3>
                    <div class="bm-overview-rows">
                        <div class="bm-overview-row">
                            <span>Tracked Groups</span>
                            <strong>@totalMuscles</strong>
                        </div>
                        <div class="bm-overview-row">
                            <span>Strong</span>
                            <strong class="text--strong">@strongCount</strong>
                        </div>
                        <div class="bm-overview-row">
                            <span>Moderate</span>
                            <strong class="text--moderate">@moderateCount</strong>
                        </div>
                        <div class="bm-overview-row">
                            <span>Needs Work</span>
                            <strong class="text--needs-work">@needsWorkCount</strong>
                        </div>
                    </div>
                    <div class="bm-overview-bar">
                        @if (strongPct > 0)
                        {
                            <div class="bm-bar-seg bm-bar-seg--strong" style="width: @(strongPct)%;"></div>
                        }
                        @if (moderatePct > 0)
                        {
                            <div class="bm-bar-seg bm-bar-seg--moderate" style="width: @(moderatePct)%;"></div>
                        }
                        @if (needsWorkPct > 0)
                        {
                            <div class="bm-bar-seg bm-bar-seg--needs-work" style="width: @(needsWorkPct)%;"></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     WEEKLY OVERVIEW
     ============================================================ -->
<section class="weekly-section reveal-up" id="weekly-progress">
    <div class="container">
        <div class="section-header">
            <div class="section-header-left">
                <h2 class="section-title">Weekly <span class="text-gradient">Overview</span></h2>
                <p class="section-subtitle">Training volume across the week</p>
            </div>
        </div>

        <div class="weekly-layout">
            <!-- Bar Chart -->
            <div class="weekly-chart panel">
                <div class="chart-area">
                    <div class="chart-y-axis">
                        <span>60m</span>
                        <span>45m</span>
                        <span>30m</span>
                        <span>15m</span>
                        <span>0m</span>
                    </div>
                    <div class="chart-bars">
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--active" style="height: 75%;" data-value="45">
                                <span class="chart-bar-tooltip">45 min</span>
                            </div>
                            <span class="chart-day">Mon</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--active" style="height: 91.7%;" data-value="55">
                                <span class="chart-bar-tooltip">55 min</span>
                            </div>
                            <span class="chart-day">Tue</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--rest" style="height: 5%;" data-value="0">
                                <span class="chart-bar-tooltip">Rest Day</span>
                            </div>
                            <span class="chart-day chart-day--rest">Wed</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--active" style="height: 66.7%;" data-value="40">
                                <span class="chart-bar-tooltip">40 min</span>
                            </div>
                            <span class="chart-day">Thu</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--active" style="height: 58.3%;" data-value="35">
                                <span class="chart-bar-tooltip">35 min</span>
                            </div>
                            <span class="chart-day">Fri</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--active chart-bar--best" style="height: 100%;" data-value="60">
                                <span class="chart-bar-tooltip">60 min</span>
                            </div>
                            <span class="chart-day">Sat</span>
                        </div>
                        <div class="chart-bar-wrapper">
                            <div class="chart-bar chart-bar--rest" style="height: 5%;" data-value="0">
                                <span class="chart-bar-tooltip">Rest Day</span>
                            </div>
                            <span class="chart-day chart-day--rest">Sun</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Side Stats -->
            <div class="weekly-stats">
                <div class="weekly-stat-item panel">
                    <div class="wstat-icon"><i class="fa-solid fa-clock"></i></div>
                    <div>
                        <span class="wstat-value">235 <span class="wstat-unit">min</span></span>
                        <span class="wstat-label">Total Training</span>
                    </div>
                </div>
                <div class="weekly-stat-item panel">
                    <div class="wstat-icon"><i class="fa-solid fa-calculator"></i></div>
                    <div>
                        <span class="wstat-value">33.6 <span class="wstat-unit">min/day</span></span>
                        <span class="wstat-label">Daily Average</span>
                    </div>
                </div>
                <div class="weekly-stat-item panel">
                    <div class="wstat-icon"><i class="fa-solid fa-bed"></i></div>
                    <div>
                        <span class="wstat-value">2 <span class="wstat-unit">days</span></span>
                        <span class="wstat-label">Rest Days</span>
                    </div>
                </div>
                <div class="weekly-stat-item panel">
                    <div class="wstat-icon wstat-icon--up"><i class="fa-solid fa-arrow-trend-up"></i></div>
                    <div>
                        <span class="wstat-value wstat-value--up">+12<span class="wstat-unit">%</span></span>
                        <span class="wstat-label">vs. Last Week</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ============================================================
     FOOTER CTA
     ============================================================ -->
<section class="footer-cta reveal" id="footer-cta">
    <div class="footer-cta-bg"></div>
    <div class="container footer-cta-inner">
        <div class="footer-cta-content">
            <h2 class="footer-cta-heading">Ready for your <span class="text-gradient">next workout?</span></h2>
            <p class="footer-cta-sub">Pick up where you left off. Every rep counts.</p>
        </div>
        <a asp-action="Index" asp-controller="Workout" class="btn-accent btn-xl">
            <i class="fa-solid fa-play"></i> Begin Workout
        </a>
    </div>
</section>


<!-- ============================================================
     STYLES
     ============================================================ -->
<style>

    /* ==================== SHARED UTILS ==================== */
    .text-gradient {
        background: linear-gradient(135deg, #e63946, #ff6b35);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .section-header-left {}

    .section-title {
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.01em;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .section-subtitle {
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    /* Panel base */
    .panel {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 14px;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .panel-title {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin: 0;
    }

    .panel-badge {
        font-size: 0.72rem;
        font-weight: 700;
        background: rgba(230,57,70,0.12);
        color: var(--accent);
        border: 1px solid rgba(230,57,70,0.2);
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
    }

    .panel-link {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transition: color 0.2s;
    }

    .panel-link:hover {
        color: var(--accent);
        text-decoration: none;
    }

    /* Buttons */
    .btn-accent {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #e63946, #ff6b35);
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .btn-accent:hover {
        filter: brightness(1.1);
        box-shadow: 0 6px 24px rgba(230,57,70,0.35);
        transform: translateY(-1px);
        color: #fff;
        text-decoration: none;
    }

    .btn-lg { padding: 0.875rem 2rem; font-size: 0.95rem; }
    .btn-xl { padding: 1.1rem 2.5rem; font-size: 1.05rem; border-radius: 10px; }
    .btn-sm { padding: 0.45rem 1rem; font-size: 0.8rem; }

    /* Reveal animations */
    .reveal,
    .reveal-up {
        opacity: 0;
        transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reveal { transform: translateY(0); }
    .reveal-up { transform: translateY(32px); }

    .reveal.revealed,
    .reveal-up.revealed {
        opacity: 1;
        transform: translateY(0);
    }


    /* ==================== WELCOME ==================== */
    .welcome-section {
        padding: 3rem 0 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .welcome-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .welcome-date {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        margin-bottom: 0.4rem;
    }

    .welcome-heading {
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        line-height: 1.1;
    }

    .welcome-sub {
        font-size: 0.92rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .welcome-sub strong {
        color: var(--text-primary);
    }

    .welcome-right {
        flex-shrink: 0;
    }


    /* ==================== STATS ==================== */
    .stats-section {
        padding: 2.5rem 0;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 14px;
        padding: 1.35rem;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, #e63946, #ff6b35);
        opacity: 0;
        transition: opacity 0.25s;
    }

    .stat-card:hover {
        border-color: rgba(230,57,70,0.18);
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .stat-card:hover::after {
        opacity: 1;
    }

    .stat-card--fire:hover {
        border-color: rgba(255,107,53,0.2);
    }

    .stat-card-top {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    /* Ring inside stat card */
    .stat-ring-wrap {
        position: relative;
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-ring-svg {
        width: 52px;
        height: 52px;
        position: absolute;
        top: 0; left: 0;
    }

    .stat-ring-svg--lg {
        width: 52px;
        height: 52px;
    }

    .stat-ring-value {
        position: relative;
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--text-primary);
        z-index: 1;
    }

    .stat-ring-value--lg {
        font-size: 0.72rem;
    }

    /* Icon box */
    .stat-icon-box {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
        background: rgba(230,57,70,0.1);
        color: var(--accent);
    }

    .stat-icon-box--fire {
        background: rgba(255,107,53,0.1);
        color: #ff6b35;
    }

    .stat-icon-box--cal {
        background: rgba(255,209,102,0.1);
        color: #ffd166;
    }

    .stat-card-text {
        flex: 1;
        min-width: 0;
    }

    .stat-label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin-bottom: 0.2rem;
    }

    .stat-value {
        display: block;
        font-size: 1.65rem;
        font-weight: 900;
        line-height: 1.15;
        color: var(--text-primary);
    }

    .stat-unit {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .stat-detail {
        display: block;
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-top: 0.15rem;
    }

    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.18rem 0.55rem;
        border-radius: 20px;
        margin-top: 0.3rem;
    }

    .stat-badge--gold {
        background: rgba(255,209,102,0.12);
        color: #ffd166;
        border: 1px solid rgba(255,209,102,0.25);
    }

    .stat-bar-track {
        height: 3px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        margin-top: 1rem;
        overflow: hidden;
    }

    .stat-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #e63946, #ff6b35);
        border-radius: 4px;
        transition: width 1s ease;
    }


    /* ==================== MAIN GRID ==================== */
    .main-section {
        padding: 2.5rem 0;
    }

    .main-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 1.5rem;
        align-items: start;
    }

    .main-left {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .main-right {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* Quick Actions */
    .action-cards {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .action-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        text-decoration: none;
        color: var(--text-primary);
        transition: all 0.22s ease;
    }

    .action-card:hover {
        background: rgba(255,255,255,0.04);
        border-color: rgba(230,57,70,0.2);
        transform: translateX(3px);
        text-decoration: none;
        color: var(--text-primary);
    }

    .action-card--primary {
        background: rgba(230,57,70,0.07);
        border-color: rgba(230,57,70,0.15);
    }

    .action-card--primary:hover {
        background: rgba(230,57,70,0.12);
        border-color: rgba(230,57,70,0.3);
    }

    .action-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(230,57,70,0.12);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        flex-shrink: 0;
    }

    .action-card-icon--secondary {
        background: rgba(255,107,53,0.1);
        color: #ff6b35;
    }

    .action-card-icon--neutral {
        background: rgba(255,255,255,0.06);
        color: var(--text-secondary);
    }

    .action-card-body {
        flex: 1;
        min-width: 0;
    }

    .action-card-title {
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.1rem;
    }

    .action-card-desc {
        display: block;
        font-size: 0.78rem;
        color: var(--text-secondary);
    }

    .action-card-arrow {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.2);
        transition: all 0.2s;
    }

    .action-card:hover .action-card-arrow {
        color: var(--accent);
        transform: translateX(2px);
    }

    /* Workout list */
    .workout-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .workout-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.9rem 1rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        transition: all 0.2s ease;
    }

    .workout-row:hover {
        background: rgba(255,255,255,0.04);
        border-color: rgba(230,57,70,0.12);
        transform: translateX(2px);
    }

    .workout-row-icon {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .wicon--red { background: rgba(230,57,70,0.12); color: #e63946; }
    .wicon--orange { background: rgba(255,107,53,0.12); color: #ff6b35; }
    .wicon--green { background: rgba(34,197,94,0.12); color: #22c55e; }
    .wicon--yellow { background: rgba(255,209,102,0.12); color: #ffd166; }

    .workout-row-info {
        flex: 1;
        min-width: 0;
    }

    .workout-row-name {
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .workout-row-tags {
        display: flex;
        gap: 0.3rem;
        flex-wrap: wrap;
    }

    .muscle-tag {
        font-size: 0.67rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: rgba(255,255,255,0.05);
        color: var(--text-secondary);
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
    }

    .workout-row-meta {
        text-align: right;
        flex-shrink: 0;
    }

    .workout-row-time {
        display: block;
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-bottom: 0.25rem;
    }

    .workout-row-stats {
        display: flex;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .workout-row-stats i {
        font-size: 0.65rem;
        margin-right: 0.2rem;
        opacity: 0.5;
    }

    .intensity-badge {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.28rem 0.65rem;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .ibadge--light {
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.4);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .ibadge--moderate {
        background: rgba(255,209,102,0.1);
        color: #ffd166;
        border: 1px solid rgba(255,209,102,0.2);
    }

    .ibadge--high {
        background: rgba(255,107,53,0.1);
        color: #ff6b35;
        border: 1px solid rgba(255,107,53,0.22);
    }

    .ibadge--extreme {
        background: rgba(230,57,70,0.1);
        color: #e63946;
        border: 1px solid rgba(230,57,70,0.22);
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--text-secondary);
    }

    .empty-state-icon {
        font-size: 2rem;
        opacity: 0.2;
        margin-bottom: 0.75rem;
    }

    .empty-state-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
    }

    .empty-state-desc {
        font-size: 0.82rem;
        margin-bottom: 1.25rem;
    }

    /* Muscle Overview */
    .muscle-overview-grid {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-bottom: 1.1rem;
    }

    .muscle-overview-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .mdot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .mdot--strong { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.5); }
    .mdot--moderate { background: #ff6b35; box-shadow: 0 0 6px rgba(255,107,53,0.5); }
    .mdot--needs-work { background: #e63946; box-shadow: 0 0 6px rgba(230,57,70,0.5); }

    .muscle-overview-name {
        font-size: 0.8rem;
        color: var(--text-secondary);
        min-width: 70px;
        flex-shrink: 0;
    }

    .muscle-overview-bar-track {
        flex: 1;
        height: 4px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        overflow: hidden;
    }

    .muscle-overview-bar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width 1s ease;
    }

    .muscle-overview-bar-fill.mdot--strong { background: rgba(34,197,94,0.6); box-shadow: none; }
    .muscle-overview-bar-fill.mdot--moderate { background: rgba(255,107,53,0.6); box-shadow: none; }
    .muscle-overview-bar-fill.mdot--needs-work { background: rgba(230,57,70,0.5); box-shadow: none; }

    .muscle-overview-legend {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255,255,255,0.04);
    }

    .legend-pill {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
    }

    .legend-pill--strong { background: rgba(34,197,94,0.1); color: #22c55e; }
    .legend-pill--moderate { background: rgba(255,107,53,0.1); color: #ff6b35; }
    .legend-pill--needs-work { background: rgba(230,57,70,0.1); color: #e63946; }

    /* Achievements sidebar */
    .achieve-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .achieve-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem;
        border-radius: 10px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        transition: all 0.2s;
    }

    .achieve-row:hover {
        border-color: rgba(255,255,255,0.08);
    }

    .achieve-row--unlocked {
        border-color: rgba(255,209,102,0.15);
        background: rgba(255,209,102,0.03);
    }

    .achieve-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .achieve-icon--gold { background: rgba(255,209,102,0.12); color: #ffd166; border: 1px solid rgba(255,209,102,0.2); }
    .achieve-icon--accent { background: rgba(230,57,70,0.1); color: var(--accent); }

    .achieve-info {
        flex: 1;
        min-width: 0;
    }

    .achieve-name {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 0.35rem;
    }

    .achieve-bar-track {
        height: 3px;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 0.3rem;
    }

    .achieve-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #e63946, #ff6b35);
        border-radius: 4px;
        transition: width 1.2s ease;
    }

    .achieve-bar-fill--complete {
        background: linear-gradient(90deg, #22c55e, #16a34a);
    }

    .achieve-label {
        font-size: 0.68rem;
        color: var(--text-secondary);
    }

    .achieve-badge--done {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: rgba(34,197,94,0.12);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        flex-shrink: 0;
    }

    .achieve-pct {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--text-secondary);
        flex-shrink: 0;
    }


    /* ==================== BODY MAP ==================== */
    .body-map-section {
        padding: 4rem 0;
        border-top: 1px solid rgba(255,255,255,0.04);
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .body-map-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: start;
    }

    .body-map-container {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 2rem 1rem;
    }

    .body-map-glow {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 280px;
        height: 400px;
        background: radial-gradient(ellipse, rgba(230,57,70,0.07) 0%, transparent 65%);
        pointer-events: none;
    }

    .body-map-svg {
        width: 100%;
        max-width: 280px;
        height: auto;
        position: relative;
        z-index: 1;
    }

    .muscle-group {
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .muscle-group:hover {
        filter: url(#activeGlow);
    }

    .muscle-group[data-status="strong"]:hover {
        fill: rgba(34,197,94,0.45);
        stroke: rgba(34,197,94,0.8);
        stroke-width: 2;
    }

    .muscle-group[data-status="moderate"]:hover {
        fill: rgba(255,107,53,0.45);
        stroke: rgba(255,107,53,0.8);
        stroke-width: 2;
    }

    .muscle-group[data-status="needs-work"]:hover {
        fill: rgba(230,57,70,0.45);
        stroke: rgba(230,57,70,0.8);
        stroke-width: 2;
    }

    @@keyframes bodyScan {
        0% { transform: translateY(0); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(520px); opacity: 0; }
    }

    .body-scan-line {
        animation: bodyScan 4s ease-in-out infinite;
    }

    @@keyframes musclePulseAnim {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .muscle-group[data-status="needs-work"] {
        animation: musclePulseAnim 2.5s ease-in-out infinite;
    }

    /* Info panel right side */
    .body-map-info-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .bm-card {
        background: var(--bg-card);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 1.35rem;
    }

    .bm-card-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .bm-legend {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .bm-legend-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .legend-dot--strong { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.5); }
    .legend-dot--moderate { background: #ff6b35; box-shadow: 0 0 8px rgba(255,107,53,0.5); }
    .legend-dot--needs-work { background: #e63946; box-shadow: 0 0 8px rgba(230,57,70,0.5); }

    .bm-legend-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .bm-legend-desc {
        display: block;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    /* Detail card */
    .bm-detail-card {
        min-height: 180px;
    }

    .muscle-detail-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 130px;
        gap: 0.6rem;
        color: var(--text-secondary);
    }

    .muscle-detail-empty i {
        font-size: 1.8rem;
        opacity: 0.3;
    }

    .muscle-detail-empty p {
        font-size: 0.82rem;
        text-align: center;
        margin: 0;
    }

    .muscle-detail-name {
        font-size: 1.2rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        margin-bottom: 0.5rem;
    }

    .muscle-detail-status {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.22rem 0.7rem;
        border-radius: 20px;
        margin-bottom: 1rem;
    }

    .muscle-detail-status.status--strong {
        background: rgba(34,197,94,0.12);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.25);
    }

    .muscle-detail-status.status--moderate {
        background: rgba(255,107,53,0.12);
        color: #ff6b35;
        border: 1px solid rgba(255,107,53,0.25);
    }

    .muscle-detail-status.status--needs-work {
        background: rgba(230,57,70,0.12);
        color: #e63946;
        border: 1px solid rgba(230,57,70,0.25);
    }

    .muscle-detail-rows {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .muscle-detail-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.83rem;
        color: var(--text-secondary);
    }

    .muscle-detail-row i {
        width: 16px;
        text-align: center;
        color: var(--accent);
        font-size: 0.8rem;
    }

    .muscle-detail-row strong {
        color: var(--text-primary);
        margin-left: auto;
    }

    .muscle-detail-cta {
        width: 100%;
        justify-content: center;
    }

    /* Overview */
    .bm-overview-rows {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .bm-overview-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.45rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        font-size: 0.83rem;
    }

    .bm-overview-row:last-child {
        border-bottom: none;
    }

    .bm-overview-row span {
        color: var(--text-secondary);
    }

    .bm-overview-row strong {
        font-weight: 800;
    }

    .text--strong { color: #22c55e; }
    .text--moderate { color: #ff6b35; }
    .text--needs-work { color: #e63946; }

    .bm-overview-bar {
        display: flex;
        height: 5px;
        border-radius: 5px;
        overflow: hidden;
        margin-top: 1rem;
        gap: 2px;
    }

    .bm-bar-seg {
        height: 100%;
        border-radius: 3px;
        transition: width 1s ease;
    }

    .bm-bar-seg--strong { background: #22c55e; }
    .bm-bar-seg--moderate { background: #ff6b35; }
    .bm-bar-seg--needs-work { background: #e63946; }

    /* Status summary pills (section header) */
    .status-summary-pills {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .status-pill {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.06);
    }

    .spill-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-pill--strong .spill-dot { background: #22c55e; }
    .status-pill--moderate .spill-dot { background: #ff6b35; }
    .status-pill--needs-work .spill-dot { background: #e63946; }


    /* ==================== WEEKLY CHART ==================== */
    .weekly-section {
        padding: 4rem 0;
    }

    .weekly-layout {
        display: grid;
        grid-template-columns: 1fr 260px;
        gap: 1.25rem;
        align-items: start;
    }

    .weekly-chart {
        padding: 1.75rem;
    }

    .chart-area {
        display: flex;
        gap: 1rem;
        align-items: flex-end;
        height: 240px;
    }

    .chart-y-axis {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        padding-bottom: 26px;
    }

    .chart-y-axis span {
        font-size: 0.68rem;
        color: var(--text-secondary);
        text-align: right;
        min-width: 26px;
    }

    .chart-bars {
        display: flex;
        gap: 0.6rem;
        flex: 1;
        align-items: flex-end;
        height: 100%;
    }

    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .chart-bar {
        width: 100%;
        max-width: 44px;
        border-radius: 5px 5px 2px 2px;
        position: relative;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .chart-bar--active {
        background: linear-gradient(180deg, #ff6b35, #e63946);
        box-shadow: 0 2px 10px rgba(230,57,70,0.18);
    }

    .chart-bar--active:hover {
        box-shadow: 0 4px 20px rgba(230,57,70,0.3);
        filter: brightness(1.15);
    }

    .chart-bar--best {
        background: linear-gradient(180deg, #ffd166, #ff6b35);
        box-shadow: 0 2px 14px rgba(255,107,53,0.25);
    }

    .chart-bar--rest {
        background: rgba(255,255,255,0.04);
    }

    .chart-bar-tooltip {
        position: absolute;
        top: -28px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--text-primary);
        background: var(--bg-secondary);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 0.18rem 0.45rem;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.2s;
        pointer-events: none;
    }

    .chart-bar:hover .chart-bar-tooltip {
        opacity: 1;
    }

    .chart-day {
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .chart-day--rest { opacity: 0.35; }

    /* Weekly side stats */
    .weekly-stats {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .weekly-stat-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1rem 1.1rem;
        transition: all 0.2s;
    }

    .weekly-stat-item:hover {
        border-color: rgba(230,57,70,0.15);
    }

    .wstat-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(230,57,70,0.1);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .wstat-icon--up {
        background: rgba(34,197,94,0.1);
        color: #22c55e;
    }

    .wstat-value {
        display: block;
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .wstat-value--up { color: #22c55e; }

    .wstat-unit {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .wstat-label {
        display: block;
        font-size: 0.7rem;
        color: var(--text-secondary);
